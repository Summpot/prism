<UserControl
    x:Class="Prism.Views.AdminUsersView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
    x:DataType="vm:AdminUsersViewModel">

    <Panel>
    <controls:AdminReady State="{Binding ReadyState}" ConnectCommand="{Binding GoToConnectCommand}"
                         IsVisible="{Binding IsReady, Converter={x:Static common:Converters.BooleanNegation}}"/>
    <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="{DynamicResource PageMargin}" IsVisible="{Binding IsReady}">
        <controls:PageHeader
            Grid.Row="0"
            Title="{Binding [nav_users], Source={x:Static i18n:LocalizationManager.Instance}}"
            Description="{Binding [admin_users_subtitle], Source={x:Static i18n:LocalizationManager.Instance}}"
            Icon="{x:Static common:AppIcons.Users}"
            Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox
                    Text="{Binding SearchQuery, Mode=TwoWay}"
                    PlaceholderText="{Binding [admin_users_search], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Width="200"/>
                <Button Classes="Outline" Command="{Binding ToggleAutoRefreshCommand}">
                    <TextBlock Text="{Binding AutoRefreshText}"/>
                </Button>
                <Button Classes="Outline" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={x:Static common:Converters.BooleanNegation}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="16" Height="16"/>
                        <TextBlock Text="{Binding [common_refresh], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <controls:ErrorBanner
            Grid.Row="1"
            Message="{Binding ErrorMessage}"
            RetryCommand="{Binding RefreshCommand}"
            Margin="0,0,0,12"/>

        <shadui:Card Grid.Row="2" Margin="0,0,0,12" IsVisible="{Binding HasSession}">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding [session_logged_in], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                    <TextBlock Text="{Binding SessionName}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SessionDetail}" Foreground="{DynamicResource MutedForegroundColor}"/>
                </StackPanel>
                <shadui:Badge
                    Grid.Column="1"
                    IsVisible="{Binding SessionIsAdmin}"
                    Content="{Binding [users_session_admin], Source={x:Static i18n:LocalizationManager.Instance}}"
                    VerticalAlignment="Center"/>
            </Grid>
        </shadui:Card>

        <!-- Tabbed User & Token Content -->
        <TabControl Grid.Row="3">
            <!-- Tab 1: Users -->
            <TabItem Header="{Binding [users_title], Source={x:Static i18n:LocalizationManager.Instance}}">
                <Grid Margin="0,16,0,0">
                            <DataGrid
                                ItemsSource="{Binding Users}"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserResizeColumns="True"
                                GridLinesVisibility="Horizontal"
                                BorderThickness="0"
                                Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding [admin_col_username], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Username}" MinWidth="120" Width="*"/>
                                    <DataGridTemplateColumn Header="{Binding [admin_col_role], Source={x:Static i18n:LocalizationManager.Instance}}" MinWidth="80" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:UserRowItem">
                                                <shadui:Badge
                                                    Content="{Binding Role, Converter={x:Static common:Converters.RoleLabel}}"
                                                    VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{Binding [admin_col_oauth_id], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding GithubId}" MinWidth="110" Width="1.2*"/>
                                    <DataGridTextColumn Header="{Binding [admin_col_created_date], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding CreatedAt}" MinWidth="120" Width="140"/>
                                    <DataGridTemplateColumn Header="{Binding [admin_col_action], Source={x:Static i18n:LocalizationManager.Instance}}" MinWidth="110" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:UserRowItem">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button
                                                        Classes="Outline"
                                                        Command="{Binding #Root.((vm:AdminUsersViewModel)DataContext).OpenEditUserDialogCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding [common_edit], Source={x:Static i18n:LocalizationManager.Instance}, FallbackValue='编辑'}"/>
                                                    <Button
                                                        Classes="Ghost"
                                                        Command="{Binding #Root.((vm:AdminUsersViewModel)DataContext).ToggleUserRoleCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="{Binding [users_toggle_role], Source={x:Static i18n:LocalizationManager.Instance}}" Width="22">
                                                        <common:LucideIcon Data="{x:Static common:AppIcons.SlidersHorizontal}" Width="16" Height="16"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <controls:EmptyState
                                IsVisible="{Binding Users.Count, Converter={x:Static common:Converters.EqualsZero}}"
                                Icon="{x:Static common:AppIcons.Users}"
                                Title="{Binding [users_no_users_title], Source={x:Static i18n:LocalizationManager.Instance}}"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Grid>
            </TabItem>

            <!-- Tab 2: Access Tokens -->
            <TabItem Header="{Binding [admin_col_access_tokens], Source={x:Static i18n:LocalizationManager.Instance}}">
                <Grid RowDefinitions="Auto, *" Margin="0,16,0,0">
                        <!-- Toolbar -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                            <TextBlock Text="{Binding [admin_users_active_tokens], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="Primary" Command="{Binding OpenCreateTokenDialogCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <common:LucideIcon Data="{x:Static common:AppIcons.Plus}" Width="16" Height="16" Foreground="{DynamicResource PrimaryForegroundColor}"/>
                                    <TextBlock Text="{Binding [users_generate_token], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Tokens Table -->
                        <Grid Grid.Row="1">
                            <DataGrid
                                ItemsSource="{Binding Tokens}"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserResizeColumns="True"
                                GridLinesVisibility="Horizontal"
                                BorderThickness="0"
                                Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding [admin_col_token_name], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Name}" MinWidth="130" Width="*"/>
                                    <DataGridTemplateColumn Header="{Binding [admin_col_type], Source={x:Static i18n:LocalizationManager.Instance}}" MinWidth="80" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:TokenRowItem">
                                                <TextBlock Text="{Binding TokenType, Converter={x:Static common:Converters.TokenTypeLabel}}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{Binding [admin_col_created], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding CreatedAt}" MinWidth="120" Width="135"/>
                                    <DataGridTextColumn Header="{Binding [admin_col_expires], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding ExpiresAt}" MinWidth="120" Width="135"/>
                                    <DataGridTextColumn Header="{Binding [admin_col_last_used], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding LastUsed}" MinWidth="120" Width="135"/>
                                    <DataGridTemplateColumn Header="{Binding [admin_col_action], Source={x:Static i18n:LocalizationManager.Instance}}" MinWidth="80" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:TokenRowItem">
                                                <Button
                                                    Classes="Outline"
                                                    Command="{Binding #Root.((vm:AdminUsersViewModel)DataContext).RevokeTokenCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding [users_revoke], Source={x:Static i18n:LocalizationManager.Instance}}"
                                                    Foreground="{DynamicResource DestructiveColor}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <controls:EmptyState
                                IsVisible="{Binding Tokens.Count, Converter={x:Static common:Converters.EqualsZero}}"
                                Icon="{x:Static common:AppIcons.Shield}"
                                Title="{Binding [users_no_tokens_title], Source={x:Static i18n:LocalizationManager.Instance}}"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
            </TabItem>
        </TabControl>
    </Grid>
    </Panel>
</UserControl>
