<UserControl
    x:Class="Prism.Views.AdminTunnelServicesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
    x:DataType="vm:AdminTunnelServicesViewModel">

    <Panel>
    <controls:AdminReady State="{Binding ReadyState}" ConnectCommand="{Binding GoToConnectCommand}"
                         IsVisible="{Binding IsReady, Converter={x:Static common:Converters.BooleanNegation}}"/>
    <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="16" IsVisible="{Binding IsReady}">
        <controls:PageHeader
            Grid.Row="0"
            Title="{Binding [nav_services], Source={x:Static i18n:LocalizationManager.Instance}}"
            Description="{Binding [admin_services_subtitle], Source={x:Static i18n:LocalizationManager.Instance}}"
            Icon="{x:Static common:AppIcons.Server}"
            Margin="0,0,0,16">
            <controls:PageHeader.Badge>
                <shadui:Badge Content="{Binding Services.Count}" Height="20" Padding="6,0" FontSize="10" VerticalAlignment="Center"/>
            </controls:PageHeader.Badge>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="Outline" Command="{Binding ToggleAutoRefreshCommand}" Height="28" Padding="10,0">
                    <TextBlock Text="{Binding AutoRefreshText}" FontSize="11"/>
                </Button>
                <Button Classes="Outline" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={x:Static common:Converters.BooleanNegation}}"
                        Height="28" Padding="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="12" Height="12"/>
                        <TextBlock Text="{Binding [common_refresh], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <controls:ErrorBanner
            Grid.Row="1"
            Message="{Binding ErrorMessage}"
            RetryCommand="{Binding RefreshCommand}"
            Margin="0,0,0,12"/>

        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
            <TextBox
                Grid.Column="0"
                Text="{Binding SearchQuery, Mode=TwoWay}"
                PlaceholderText="{Binding [admin_services_filter], Source={x:Static i18n:LocalizationManager.Instance}}"
                Height="28"
                FontSize="11"
                Margin="0,0,8,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding PrimaryOnly, Mode=TwoWay}" OnContent="" OffContent=""/>
                <TextBlock Text="{Binding [services_primary_only], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Services Table -->
        <shadui:Card Grid.Row="3" Padding="12">
            <Grid>
                <DataGrid
                    ItemsSource="{Binding Services}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding [admin_col_service_name], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="{Binding [admin_col_protocol], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Proto}" Width="80"/>
                        <DataGridTextColumn Header="{Binding [admin_col_client_id], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding ClientDisplay}" Width="*"/>
                        <DataGridTextColumn Header="{Binding [admin_col_remote_addr], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Remote}" Width="*"/>
                        <DataGridTextColumn Header="{Binding [admin_col_role], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding RoleText}" Width="90"/>
                        <DataGridTextColumn Header="{Binding [admin_col_route], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding RouteText}" Width="90"/>
                        <DataGridTextColumn Header="{Binding [admin_col_local_addr], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding LocalAddr}" Width="*"/>
                        <DataGridTextColumn Header="{Binding [admin_col_remote_target], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding RemoteAddr}" Width="*"/>
                        <DataGridTextColumn Header="{Binding [admin_col_masquerade_sni], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Masquerade}" Width="*"/>
                        <DataGridTemplateColumn Header="{Binding [admin_col_status], Source={x:Static i18n:LocalizationManager.Instance}}" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ServiceRowItem">
                                    <shadui:Badge Content="{Binding IsActive, Converter={x:Static common:Converters.ActiveStatusToLabel}}"
                                                 Background="{Binding IsActive, Converter={x:Static common:Converters.ActiveStatusToBrush}}"
                                                 Foreground="White" Height="18" Padding="6,0" FontSize="10" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:EmptyState
                    IsVisible="{Binding Services.Count, Converter={x:Static common:Converters.EqualsZero}}"
                    Icon="{x:Static common:AppIcons.Server}"
                    Title="{Binding [admin_no_services_found], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Margin="0,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>
        </shadui:Card>
    </Grid>
    </Panel>
</UserControl>
