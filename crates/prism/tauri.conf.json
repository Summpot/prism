{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Prism",
	"version": "0.1.0",
	"identifier": "com.prism.client",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:3000",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../../dist/client"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"title": "Prism",
				"width": 1024,
				"height": 720,
				"minWidth": 800,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false,
				"url": "index.html",
				"visible": false,
				"decorations": false,
				"shadow": true
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://127.0.0.1:* ws://localhost:* https:;"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/icon.ico", "icons/icon.png"]
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["prism"]
			}
		}
	}
}
