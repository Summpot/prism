<UserControl
    x:Class="Prism.Views.AdminTrafficView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
    x:DataType="vm:AdminTrafficViewModel">

    <Panel>
    <controls:AdminReady State="{Binding ReadyState}" ConnectCommand="{Binding GoToConnectCommand}"
                         IsVisible="{Binding IsReady, Converter={x:Static common:Converters.BooleanNegation}}"/>
    <DockPanel IsVisible="{Binding IsReady}">
        <Grid
            DockPanel.Dock="Top"
            ColumnDefinitions="*, Auto"
            Margin="{DynamicResource PageMargin}"
            MaxWidth="{DynamicResource PageMaxWidth}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <common:LucideIcon Data="{x:Static common:AppIcons.ArrowDownUp}" Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding [nav_server_traffic], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="h2" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="Outline" Command="{Binding OpenConnectorsCommand}">
                    <TextBlock Text="{Binding [nav_connector_traffic], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                </Button>
                <Button Classes="Outline" Command="{Binding ToggleAutoRefreshCommand}">
                    <TextBlock Text="{Binding AutoRefreshText}"/>
                </Button>
                <Button Classes="Outline" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={x:Static common:Converters.BooleanNegation}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="16" Height="16"/>
                        <TextBlock Text="{Binding [common_refresh], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource PageContentMargin}" MaxWidth="{DynamicResource PageMaxWidth}" Spacing="16">
            <controls:ErrorBanner Message="{Binding ErrorMessage}" RetryCommand="{Binding RefreshCommand}"/>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                <shadui:Card Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="{Binding [admin_traffic_kpi_wire], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="Small"/>
                        <TextBlock Text="{Binding WireBytesText}" Classes="Large" Margin="0,12,0,0"/>
                    </StackPanel>
                </shadui:Card>

                <shadui:Card Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="{Binding [admin_traffic_kpi_raw], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="Small"/>
                        <TextBlock Text="{Binding RawBytesText}" Classes="Large" Margin="0,12,0,0"/>
                    </StackPanel>
                </shadui:Card>

                <shadui:Card Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="{Binding [admin_traffic_kpi_saved], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="Small"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <TextBlock Text="{Binding SavedBytesText}" Classes="Large" Foreground="{DynamicResource SuccessColor}"/>
                            <shadui:Badge Content="{Binding SavedRatioText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </shadui:Card>

                <shadui:Card Grid.Column="3">
                    <StackPanel>
                        <TextBlock Text="{Binding [admin_traffic_kpi_sessions], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="Small"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <TextBlock Text="{Binding LiveSessionsCount}" Classes="Large"/>
                            <TextBlock Text="{Binding LiveThroughputText}" Classes="Caption Muted" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </shadui:Card>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <!-- Uplink Card -->
                <shadui:Card Grid.Column="0">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <common:LucideIcon Data="{x:Static common:AppIcons.ArrowDownUp}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <shadui:CardTitle VerticalAlignment="Center" Content="{Binding [traffic_uplink], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                        </StackPanel>
                        
                        <Separator />

                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" Margin="0,4">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [admin_raw_wire], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UplinkRawWire}" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [traffic_p50], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UplinkP50}" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [traffic_p90], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UplinkP90}" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [traffic_p99], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding UplinkP99}" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [traffic_max], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UplinkMax}" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [traffic_batching], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding UplinkBatching}" FontWeight="SemiBold" Margin="0,4"/>
                        </Grid>
                    </StackPanel>
                </shadui:Card>

                <!-- Downlink Card -->
                <shadui:Card Grid.Column="1">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <common:LucideIcon Data="{x:Static common:AppIcons.ArrowDown}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <shadui:CardTitle VerticalAlignment="Center" Content="{Binding [traffic_downlink], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                        </StackPanel>
                        
                        <Separator />

                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" Margin="0,4">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [admin_raw_wire], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DownlinkRawWire}" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [traffic_p50], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DownlinkP50}" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [traffic_p90], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DownlinkP90}" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [traffic_p99], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DownlinkP99}" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [traffic_max], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DownlinkMax}" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [traffic_batching], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DownlinkBatching}" FontWeight="SemiBold" Margin="0,4"/>
                        </Grid>
                    </StackPanel>
                </shadui:Card>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
    </Panel>
</UserControl>
