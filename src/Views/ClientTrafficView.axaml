<UserControl
    x:Class="Prism.Views.ClientTrafficView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    x:DataType="vm:ClientTrafficViewModel"
    mc:Ignorable="d">

    <DockPanel>
        <Grid
            DockPanel.Dock="Top"
            ColumnDefinitions="*, Auto"
            Margin="{DynamicResource PageMargin}"
            MaxWidth="{DynamicResource PageMaxWidth}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <common:LucideIcon Data="{x:Static common:AppIcons.ArrowDownUp}" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding [client_traffic_title], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="h2" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton
                            Classes="Segment"
                            IsChecked="{Binding StatsViewMode, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=session, Mode=OneWay}"
                            Command="{Binding SetStatsModeCommand}" CommandParameter="session"
                            Content="{Binding [client_session], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                        <ToggleButton
                            Classes="Segment"
                            IsChecked="{Binding StatsViewMode, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=lifetime, Mode=OneWay}"
                            Command="{Binding SetStatsModeCommand}" CommandParameter="lifetime"
                            Content="{Binding [client_lifetime], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                    </StackPanel>
                    <Button Classes="Outline" Command="{Binding ResetStatsCommand}" ToolTip.Tip="{Binding [client_reset_stats], Source={x:Static i18n:LocalizationManager.Instance}}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="16" Height="16"/>
                            <TextBlock Text="{Binding [client_reset], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
        </Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{DynamicResource PageMaxWidth}" Spacing="16" Margin="{DynamicResource PageContentMargin}">

            <controls:EmptyState
                IsVisible="{Binding ShowEmptyState}"
                Icon="{x:Static common:AppIcons.WifiOff}"
                Title="{Binding [client_traffic_disconnected], Source={x:Static i18n:LocalizationManager.Instance}}"
                Description="{Binding [client_traffic_disconnected_hint], Source={x:Static i18n:LocalizationManager.Instance}}"/>

            <!-- Traffic Content Area -->
            <StackPanel IsVisible="{Binding HasTrafficData}" Spacing="16">

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                    <shadui:Card Grid.Column="0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Metric1Title}" Classes="Small Muted" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Metric1Value}" Classes="Large" FontFamily="{DynamicResource MonoFont}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </shadui:Card>
                    <shadui:Card Grid.Column="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [client_raw], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="Small Muted" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RawBytesText}" Classes="Large" FontFamily="{DynamicResource MonoFont}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </shadui:Card>
                    <shadui:Card Grid.Column="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [client_wire], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="Small Muted" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding WireBytesText}" Classes="Large" FontFamily="{DynamicResource MonoFont}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </shadui:Card>
                    <shadui:Card Grid.Column="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [client_saved], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="Small" Foreground="{DynamicResource SuccessColor}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SavedRatioText}" Classes="Large" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SuccessColor}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </shadui:Card>
                </Grid>

                <!-- Real-Time Throughput Graph (Connected only) -->
                <shadui:Card IsVisible="{Binding IsConnected}">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <common:LucideIcon Data="{x:Static common:AppIcons.Activity}" Width="16" Height="16" Foreground="{DynamicResource SuccessColor}"/>
                                <TextBlock Text="{Binding [traffic_throughput], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentThroughputText}" Foreground="{DynamicResource SuccessColor}" FontWeight="Bold" FontFamily="{DynamicResource MonoFont}"/>
                        </Grid>
                        <common:SparklineControl
                            Height="64"
                            Samples="{Binding ThroughputSeries}"
                            Stroke="{DynamicResource StatusSuccessBrush}"
                            Fill="{DynamicResource StatusSuccessFillBrush}"
                            StrokeThickness="2"
                            Margin="0,6,0,2"/>
                    </StackPanel>
                </shadui:Card>

                <!-- Detailed Section Card (Session or Lifetime) -->
                <shadui:Card>
                    <StackPanel Spacing="12">
                        <!-- Card Header -->
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="{Binding SectionTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" IsVisible="{Binding HasTransport}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActualTransport}" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource MutedForegroundColor}"/>
                            </Border>
                        </Grid>

                        <!-- Session Mode Details -->
                        <StackPanel IsVisible="{Binding IsSessionMode}" Spacing="8">
                            <!-- Row 1: 4 Stats -->
                            <Grid ColumnDefinitions="*, *, *, *">
                                <Border Grid.Column="0" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="10,8" Margin="0,0,4,0">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding [client_raw], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                        <TextBlock Text="{Binding SessionRawBytes}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="10,8" Margin="4,0,4,0">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding [client_wire], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                        <TextBlock Text="{Binding SessionWireBytes}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="10,8" Margin="4,0,4,0">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding [client_saved], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource SuccessColor}"/>
                                        <TextBlock Text="{Binding SessionSavedText}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SuccessColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="10,8" Margin="4,0,0,0">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding [traffic_link_rate], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                        <TextBlock Text="{Binding SessionLinkRate}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 2: 3 Batch Stats -->
                            <Grid ColumnDefinitions="*, *, *">
                                <Border Grid.Column="0" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="10,8" Margin="0,0,4,0">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding [traffic_batches_urgent], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                        <TextBlock Text="{Binding UrgentBatchesText}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="10,8" Margin="4,0,4,0">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding [traffic_batches_timer], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                        <TextBlock Text="{Binding TimerBatchesText}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="10,8" Margin="4,0,0,0">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding [traffic_batches_threshold], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                        <TextBlock Text="{Binding ThresholdBatchesText}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 3: Uplink & Downlink Direction Cards -->
                            <Grid ColumnDefinitions="*, *">
                                <!-- Uplink Direction Card -->
                                <Border Grid.Column="0" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource MdCornerRadius}" Padding="12" Margin="0,0,4,0">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="↑" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}"/>
                                                <TextBlock Text="{Binding [traffic_uplink], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryColor}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding UplinkRawWireText}" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="*, *">
                                            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="8,6" Margin="0,0,3,0">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding [client_saved], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource SuccessColor}"/>
                                                    <TextBlock Text="{Binding UplinkSavedRatio}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SuccessColor}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="8,6" Margin="3,0,0,0">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding [traffic_batches], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                                    <TextBlock Text="{Binding UplinkBatches}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Quantile Row: Batching -->
                                        <Grid ColumnDefinitions="50, *, *, *, *" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding [client_batching], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P50" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkBatchingP50}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P90" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkBatchingP90}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P99" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkBatchingP99}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="4" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="MAX" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkBatchingMax}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Quantile Row: Compression -->
                                        <Grid ColumnDefinitions="50, *, *, *, *" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding [client_compression], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P50" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkCompP50}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P90" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkCompP90}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P99" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkCompP99}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="4" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="MAX" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkCompMax}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Downlink Direction Card -->
                                <Border Grid.Column="1" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource MdCornerRadius}" Padding="12" Margin="4,0,0,0">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="↓" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}"/>
                                                <TextBlock Text="{Binding [traffic_downlink], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryColor}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding DownlinkRawWireText}" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="*, *">
                                            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="8,6" Margin="0,0,3,0">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding [client_saved], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource SuccessColor}"/>
                                                    <TextBlock Text="{Binding DownlinkSavedRatio}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SuccessColor}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="8,6" Margin="3,0,0,0">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding [traffic_batches], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                                    <TextBlock Text="{Binding DownlinkBatches}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Quantile Row: Batching -->
                                        <Grid ColumnDefinitions="50, *, *, *, *" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding [client_batching], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P50" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkBatchingP50}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P90" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkBatchingP90}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P99" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkBatchingP99}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="4" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="MAX" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkBatchingMax}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Quantile Row: Compression -->
                                        <Grid ColumnDefinitions="50, *, *, *, *" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding [client_compression], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P50" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkCompP50}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P90" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkCompP90}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P99" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkCompP99}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="4" Background="{DynamicResource CardBackgroundColor}" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="MAX" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkCompMax}" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Lifetime Mode Details (3 Cards) -->
                        <Grid IsVisible="{Binding IsLifetimeMode}" ColumnDefinitions="*, *, *">
                            <Border Grid.Column="0" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="12,10" Margin="0,0,4,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding [client_raw], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                    <TextBlock Text="{Binding LifetimeRawText}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="12,10" Margin="4,0,4,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding [client_wire], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                    <TextBlock Text="{Binding LifetimeWireText}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="12,10" Margin="4,0,0,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding [client_saved], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource SuccessColor}"/>
                                    <TextBlock Text="{Binding LifetimeSavedText}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SuccessColor}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </shadui:Card>

            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
