<UserControl
    x:Class="Prism.Views.LoginView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
    x:DataType="vm:LoginViewModel">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
        <shadui:Card Width="400" Padding="28">
            <StackPanel Spacing="16">
                <!-- Icon & Title -->
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <common:LucideIcon Data="{x:Static common:AppIcons.Shield}" Width="36" Height="36" Foreground="{DynamicResource PrimaryColor}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Management Node Login" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="Connect to Prism Management Control Plane" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Base URL -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Server Base URL" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                    <TextBox Text="{Binding BaseUrl, Mode=TwoWay}" Height="34" FontSize="12"/>
                </StackPanel>

                <!-- Token -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Authentication Token" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                    <TextBox Text="{Binding StaticToken, Mode=TwoWay}" PasswordChar="●" Height="34" FontSize="12"/>
                </StackPanel>

                <!-- Error Display -->
                <TextBlock
                    IsVisible="{Binding ErrorMessage, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                    Text="{Binding ErrorMessage}"
                    Foreground="#ef4444"
                    FontSize="11"
                    TextWrapping="Wrap"/>

                <!-- Action: Token Connect -->
                <Button
                    Classes="Primary"
                    Command="{Binding ConnectWithTokenCommand}"
                    IsEnabled="{Binding IsConnecting, Converter={x:Static common:Converters.BooleanNegation}}"
                    Content="Connect with Token"
                    Height="34"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    FontSize="12"/>

                <Grid ColumnDefinitions="*, Auto, *" Margin="0,4">
                    <Separator Grid.Column="0" Background="{DynamicResource BorderColor}" Height="1"/>
                    <TextBlock Grid.Column="1" Text="OR" Margin="10,0" FontSize="10" Foreground="{DynamicResource MutedForegroundColor}"/>
                    <Separator Grid.Column="2" Background="{DynamicResource BorderColor}" Height="1"/>
                </Grid>

                <!-- Action: GitHub Login -->
                <Button
                    Classes="Outline"
                    Command="{Binding LoginWithGitHubCommand}"
                    Content="Sign in with GitHub"
                    Height="34"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    FontSize="12"/>
            </StackPanel>
        </shadui:Card>
    </Grid>
</UserControl>
