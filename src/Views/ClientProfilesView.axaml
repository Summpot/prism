<UserControl
    x:Class="Prism.Views.ClientProfilesView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    x:DataType="vm:ClientProfilesViewModel"
    mc:Ignorable="d">

    <Grid ColumnDefinitions="360, 8, *" Margin="16">
        <!-- Left: Profiles List -->
        <shadui:Card Grid.Column="0" Padding="12">
            <Grid RowDefinitions="Auto, Auto, *">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                    <TextBlock Text="{Binding [client_saved_profiles], Source={x:Static i18n:LocalizationManager.Instance}}"
                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Classes="Outline" Command="{Binding ToggleImportBoxCommand}" Height="28" Padding="10,0"
                                ToolTip.Tip="{Binding [client_import_link], Source={x:Static i18n:LocalizationManager.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <common:LucideIcon Data="{x:Static common:AppIcons.Download}" Width="12" Height="12"/>
                                <TextBlock Text="{Binding [client_import_link], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="Primary" Command="{Binding NewProfileCommand}" Height="28" Padding="10,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <common:LucideIcon Data="{x:Static common:AppIcons.Plus}" Width="12" Height="12" Foreground="{DynamicResource PrimaryForegroundColor}"/>
                                <TextBlock Text="{Binding [client_new_profile], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Import Box Collapsible -->
                <shadui:Card Grid.Row="1" IsVisible="{Binding ShowImportBox}" Margin="0,0,0,10" Padding="10">
                    <Grid RowDefinitions="Auto, Auto" RowSpacing="8">
                        <TextBox Grid.Row="0" Text="{Binding ImportInputText, Mode=TwoWay}"
                                 PlaceholderText="{Binding [client_import_placeholder], Source={x:Static i18n:LocalizationManager.Instance}}"
                                 Height="32" FontSize="11"/>
                        <Button Grid.Row="1" Classes="Primary" Command="{Binding ImportLinkCommand}"
                                Content="{Binding [client_import_apply], Source={x:Static i18n:LocalizationManager.Instance}}"
                                Height="28" FontSize="11" HorizontalAlignment="Stretch"/>
                    </Grid>
                </shadui:Card>

                <!-- Profiles List -->
                <Grid Grid.Row="2">
                    <ListBox
                        ItemsSource="{Binding Profiles}"
                        SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditableProfile">
                                <Grid ColumnDefinitions="*, Auto" Margin="2,4">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                            <shadui:Badge Content="{Binding Transport}" Height="16" Padding="4,0" FontSize="9"/>
                                            <shadui:Badge IsVisible="{Binding IsActive}"
                                                          Content="{Binding [client_active], Source={x:Static i18n:LocalizationManager.Instance}}"
                                                          Background="#10b981" Foreground="White" Height="16" Padding="4,0" FontSize="9"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ServerAddr}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Classes="Ghost"
                                        Command="{Binding #Root.((vm:ClientProfilesViewModel)DataContext).DeleteProfileCommand}"
                                        CommandParameter="{Binding}"
                                        Height="26"
                                        Width="26"
                                        Padding="4"
                                        ToolTip.Tip="{Binding [client_delete_profile], Source={x:Static i18n:LocalizationManager.Instance}}">
                                        <common:LucideIcon Data="{x:Static common:AppIcons.Trash2}" Width="13" Height="13" Foreground="#ef4444"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty List Hint -->
                    <StackPanel
                        IsVisible="{Binding Profiles.Count, Converter={x:Static common:Converters.EqualsZero}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Margin="16">
                        <common:LucideIcon Data="{x:Static common:AppIcons.Sliders}" Width="28" Height="28" Foreground="{DynamicResource MutedForegroundColor}"/>
                        <TextBlock Text="{Binding [client_no_profiles], Source={x:Static i18n:LocalizationManager.Instance}}"
                                   FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </shadui:Card>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="8" Background="Transparent" ResizeDirection="Columns"/>

        <!-- Right: Profile Editor Form -->
        <shadui:Card Grid.Column="2" Padding="16">
            <Grid>
                <!-- Editor Form (visible when a profile is selected) -->
                <ScrollViewer
                    IsVisible="{Binding SelectedProfile, Converter={x:Static common:Converters.NullToBoolean}}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding [client_settings_title], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="Bold" FontSize="14"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding DraftProfile.Name}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}"/>
                                    <shadui:Badge Content="{Binding [client_unsaved], Source={x:Static i18n:LocalizationManager.Instance}}" IsVisible="{Binding IsDirty}" Background="#f59e0b" Foreground="White" Height="16" Padding="4,0" FontSize="9"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Latency Test -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock IsVisible="{Binding PingMs, Converter={x:Static common:Converters.NullToBoolean}}"
                                           Text="{Binding PingMs, StringFormat='Ping: {0} ms'}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#10b981" VerticalAlignment="Center"/>
                                <Button Classes="Outline" Command="{Binding PingServerCommand}" IsEnabled="{Binding !IsPinging}" Height="28" FontSize="11" Padding="10,0">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <common:LucideIcon Data="{x:Static common:AppIcons.Activity}" Width="12" Height="12"/>
                                        <TextBlock Text="{Binding [client_test_latency], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource BorderColor}" Margin="0,2"/>

                        <!-- Profile Name -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding [client_profile_name], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                            <TextBox Text="{Binding DraftProfile.Name, Mode=TwoWay}"
                                     PlaceholderText="{Binding [client_profile_name_placeholder], Source={x:Static i18n:LocalizationManager.Instance}}"
                                     Height="32" FontSize="12" CornerRadius="6"/>
                        </StackPanel>

                        <!-- Server Address -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding [nodecfg_server_address], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                            <TextBox Text="{Binding DraftProfile.ServerAddr, Mode=TwoWay}"
                                     PlaceholderText="{Binding [nodecfg_server_address_hint], Source={x:Static i18n:LocalizationManager.Instance}}"
                                     Height="32" FontSize="12" CornerRadius="6"/>
                        </StackPanel>

                        <!-- Transport -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding [client_transport], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                            <ComboBox
                                ItemsSource="{Binding AvailableTransports}"
                                SelectedItem="{Binding DraftProfile.Transport, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"
                                Height="32"
                                CornerRadius="6"
                                FontSize="12"/>
                        </StackPanel>

                        <!-- Listen Address -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding [client_listen_address], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                            <TextBox Text="{Binding DraftProfile.ListenAddr, Mode=TwoWay}"
                                     PlaceholderText="{Binding [nodecfg_listen_address_hint], Source={x:Static i18n:LocalizationManager.Instance}}"
                                     Height="32" FontSize="12" CornerRadius="6"/>
                        </StackPanel>

                        <!-- Minecraft LAN Broadcast Switch -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [client_lan_broadcast], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" FontWeight="Medium"/>
                                <TextBlock Text="{Binding [client_lan_broadcast_hint], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding DraftProfile.FakeLanBroadcast, Mode=TwoWay}"/>
                        </Grid>

                        <!-- Auto Connect on Launch Switch -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [client_auto_connect], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" FontWeight="Medium"/>
                                <TextBlock Text="{Binding [client_auto_connect_hint], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding DraftProfile.AutoConnect, Mode=TwoWay}"/>
                        </Grid>

                        <!-- Management URL -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding [settings_management_url], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                            <TextBox Text="{Binding DraftProfile.ManagementUrl, Mode=TwoWay}"
                                     PlaceholderText="http://127.0.0.1:8080"
                                     Height="32" FontSize="12" CornerRadius="6"/>
                        </StackPanel>

                        <!-- Actions Bar -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Classes="Primary" Command="{Binding SaveSelectedProfileCommand}"
                                    Content="{Binding [client_save_profile], Source={x:Static i18n:LocalizationManager.Instance}}"
                                    Height="32" FontSize="12" Padding="14,0" CornerRadius="6"/>
                            <Button Classes="Ghost" Command="{Binding RevertDraftCommand}"
                                    IsEnabled="{Binding IsDirty}"
                                    Content="{Binding [client_revert], Source={x:Static i18n:LocalizationManager.Instance}}"
                                    Height="32" FontSize="12" Padding="12,0" CornerRadius="6"/>
                            <Button Classes="Outline" Command="{Binding SetActiveProfileCommand}"
                                    Content="{Binding [client_set_as_active], Source={x:Static i18n:LocalizationManager.Instance}}"
                                    Height="32" FontSize="12" Padding="14,0" CornerRadius="6"/>
                            <Button Classes="Outline" Command="{Binding ShareLinkCommand}" Height="32" FontSize="12" Padding="12,0" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <common:LucideIcon Data="{x:Static common:AppIcons.Share2}" Width="12" Height="12"/>
                                    <TextBlock Text="{Binding [client_share_config], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Status Notification -->
                        <TextBlock
                            IsVisible="{Binding StatusMessage, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                            Text="{Binding StatusMessage}"
                            FontSize="12"
                            Foreground="{DynamicResource PrimaryColor}"
                            Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Empty Selection View -->
                <StackPanel
                    IsVisible="{Binding SelectedProfile, Converter={x:Static common:Converters.NullToTrue}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <common:LucideIcon Data="{x:Static common:AppIcons.Settings}" Width="32" Height="32" Foreground="{DynamicResource MutedForegroundColor}"/>
                    <TextBlock Text="{Binding [client_no_profile_selected], Source={x:Static i18n:LocalizationManager.Instance}}"
                               FontSize="13" Foreground="{DynamicResource MutedForegroundColor}"/>
                </StackPanel>
            </Grid>
        </shadui:Card>
    </Grid>
</UserControl>
