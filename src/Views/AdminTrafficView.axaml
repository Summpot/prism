<UserControl
    x:Class="Prism.Views.AdminTrafficView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
    x:DataType="vm:AdminTrafficViewModel">

    <Panel>
    <controls:AdminReady State="{Binding ReadyState}" ConnectCommand="{Binding GoToConnectCommand}"
                         IsVisible="{Binding IsReady, Converter={x:Static common:Converters.BooleanNegation}}"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsReady}">
        <StackPanel Margin="16" Spacing="12">
            <controls:PageHeader
                Title="{Binding [nav_server_traffic], Source={x:Static i18n:LocalizationManager.Instance}}"
                Description="{Binding [admin_traffic_description], Source={x:Static i18n:LocalizationManager.Instance}}"
                Icon="{x:Static common:AppIcons.ArrowDownUp}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="Outline" Command="{Binding OpenConnectorsCommand}" Height="28" Padding="10,0">
                        <TextBlock Text="{Binding [nav_connector_traffic], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11"/>
                    </Button>
                    <Button Classes="Outline" Command="{Binding ToggleAutoRefreshCommand}" Height="28" Padding="10,0">
                        <TextBlock Text="{Binding AutoRefreshText}" FontSize="11"/>
                    </Button>
                    <Button Classes="Outline" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsLoading, Converter={x:Static common:Converters.BooleanNegation}}"
                            Height="28" Padding="10,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="12" Height="12"/>
                            <TextBlock Text="{Binding [common_refresh], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:PageHeader>

            <controls:ErrorBanner Message="{Binding ErrorMessage}" RetryCommand="{Binding RefreshCommand}"/>

            <!-- Summary KPI Grid -->
            <Grid ColumnDefinitions="*, *, *, *" Margin="0,0,0,8">
                <Grid.Styles>
                    <Style Selector="shadui|Card">
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="Padding" Value="14"/>
                    </Style>
                </Grid.Styles>

                <!-- Wire Bytes -->
                <shadui:Card Grid.Column="0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [admin_traffic_kpi_wire], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                        <TextBlock Text="{Binding WireBytesText}" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </shadui:Card>

                <!-- Raw Bytes -->
                <shadui:Card Grid.Column="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [admin_traffic_kpi_raw], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                        <TextBlock Text="{Binding RawBytesText}" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </shadui:Card>

                <!-- Saved Ratio -->
                <shadui:Card Grid.Column="2">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [admin_traffic_kpi_saved], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SavedBytesText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}"/>
                            <shadui:Badge Content="{Binding SavedRatioText}" Height="18" Padding="4,0" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </shadui:Card>

                <!-- Live Sessions -->
                <shadui:Card Grid.Column="3">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [admin_traffic_kpi_sessions], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LiveSessionsCount}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding LiveThroughputText}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </shadui:Card>
            </Grid>

            <!-- Uplink & Downlink Details -->
            <Grid ColumnDefinitions="*, *" Margin="0,0,0,16">
                <!-- Uplink Card -->
                <shadui:Card Grid.Column="0" Margin="4" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <common:LucideIcon Data="{x:Static common:AppIcons.ArrowDownUp}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding [traffic_uplink], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                        
                        <Separator Height="1" Background="{DynamicResource BorderColor}"/>

                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" Margin="0,4">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [admin_raw_wire], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UplinkRawWire}" FontSize="12" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [traffic_p50], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UplinkP50}" FontSize="12" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [traffic_p90], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UplinkP90}" FontSize="12" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [traffic_p99], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding UplinkP99}" FontSize="12" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [traffic_max], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UplinkMax}" FontSize="12" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [traffic_batching], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding UplinkBatching}" FontSize="12" FontWeight="SemiBold" Margin="0,4"/>
                        </Grid>
                    </StackPanel>
                </shadui:Card>

                <!-- Downlink Card -->
                <shadui:Card Grid.Column="1" Margin="4" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <common:LucideIcon Data="{x:Static common:AppIcons.ArrowDown}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding [traffic_downlink], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                        
                        <Separator Height="1" Background="{DynamicResource BorderColor}"/>

                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" Margin="0,4">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [admin_raw_wire], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DownlinkRawWire}" FontSize="12" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [traffic_p50], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DownlinkP50}" FontSize="12" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [traffic_p90], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DownlinkP90}" FontSize="12" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [traffic_p99], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DownlinkP99}" FontSize="12" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [traffic_max], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DownlinkMax}" FontSize="12" FontWeight="SemiBold" Margin="0,4"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [traffic_batching], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}" Margin="0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DownlinkBatching}" FontSize="12" FontWeight="SemiBold" Margin="0,4"/>
                        </Grid>
                    </StackPanel>
                </shadui:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
    </Panel>
</UserControl>
