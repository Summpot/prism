<shadui:Window
    x:Class="Prism.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:views="clr-namespace:Prism.Views"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:common="clr-namespace:Prism.Common"
    Title="Prism"
    Width="1100"
    Height="740"
    MinWidth="880"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:DataType="vm:MainWindowViewModel">

    <shadui:Window.Hosts>
        <shadui:DialogHost Manager="{Binding DialogManager}" x:Name="PART_DialogHost" />
        <shadui:ToastHost Manager="{Binding ToastManager}" />
    </shadui:Window.Hosts>

    <shadui:Window.DataTemplates>
        <DataTemplate DataType="vm:ClientOverviewViewModel">
            <views:ClientOverviewView />
        </DataTemplate>
        <DataTemplate DataType="vm:ClientTrafficViewModel">
            <views:ClientTrafficView />
        </DataTemplate>
        <DataTemplate DataType="vm:ClientLogsViewModel">
            <views:ClientLogsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ClientProfilesViewModel">
            <views:ClientProfilesView />
        </DataTemplate>
        <DataTemplate DataType="vm:ClientMiddlewareViewModel">
            <views:ClientMiddlewareView />
        </DataTemplate>
        <DataTemplate DataType="vm:ClientOptimizerViewModel">
            <views:ClientOptimizerView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:AdminOverviewViewModel">
            <views:AdminOverviewView />
        </DataTemplate>
        <DataTemplate DataType="vm:AdminConnectionsViewModel">
            <views:AdminConnectionsView />
        </DataTemplate>
        <DataTemplate DataType="vm:AdminTunnelServicesViewModel">
            <views:AdminTunnelServicesView />
        </DataTemplate>
        <DataTemplate DataType="vm:AdminUsersViewModel">
            <views:AdminUsersView />
        </DataTemplate>
    </shadui:Window.DataTemplates>

    <shadui:Window.RightWindowTitleBarContent>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0" VerticalAlignment="Center">
            <!-- Language Switcher Dropdown -->
            <ComboBox
                ItemsSource="{x:Static vm:MainWindowViewModel.AvailableLocales}"
                SelectedValue="{Binding CurrentLocale, Mode=TwoWay}"
                SelectedValueBinding="{Binding Key, x:DataType=common:LocaleOption}"
                DisplayMemberBinding="{Binding Value, x:DataType=common:LocaleOption}"
                Width="105"
                Height="28"
                FontSize="11"
                Padding="6,2"/>

        </StackPanel>
    </shadui:Window.RightWindowTitleBarContent>

    <Grid ColumnDefinitions="Auto, *">
        <!-- Sidebar Navigation -->
        <shadui:Sidebar
            Grid.Column="0"
            CurrentRoute="{Binding Navigation.CurrentRoute, Mode=TwoWay}"
            Expanded="{Binding IsSidebarExpanded, Mode=TwoWay}"
            Width="220"
            MinWidth="60">
            <shadui:Sidebar.Header>
                <Grid ColumnDefinitions="Auto, *, Auto" Margin="4,0">
                    <Image Grid.Column="0" Source="avares://Prism/Assets/logo192.png" Width="24" Height="24" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="PRISM" FontWeight="Bold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}"/>
                    <Button Grid.Column="2" Classes="Ghost" Command="{Binding ToggleSidebarCommand}" Width="28" Height="28" Padding="4">
                        <common:LucideIcon Data="{x:Static common:AppIcons.PanelLeft}" Width="14" Height="14"/>
                    </Button>
                </Grid>
            </shadui:Sidebar.Header>

            <StackPanel Spacing="3">
                <shadui:SidebarItemLabel AsSeparator="True" Text="{Binding [nav_client], Source={x:Static i18n:LocalizationManager.Instance}}" />
                <shadui:SidebarItem Route="client.overview" Content="{Binding [nav_overview], Source={x:Static i18n:LocalizationManager.Instance}}">
                    <shadui:SidebarItem.Icon>
                        <common:LucideIcon Data="{x:Static common:AppIcons.Gamepad2}" Width="16" Height="16"/>
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>
                <shadui:SidebarItem Route="client.traffic" Content="{Binding [nav_traffic], Source={x:Static i18n:LocalizationManager.Instance}}">
                    <shadui:SidebarItem.Icon>
                        <common:LucideIcon Data="{x:Static common:AppIcons.Activity}" Width="16" Height="16"/>
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>
                <shadui:SidebarItem Route="client.optimizer" Content="{Binding [nav_optimizer], Source={x:Static i18n:LocalizationManager.Instance}}">
                    <shadui:SidebarItem.Icon>
                        <common:LucideIcon Data="{x:Static common:AppIcons.Zap}" Width="16" Height="16"/>
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>
                <shadui:SidebarItem Route="client.profiles" Content="{Binding [nav_tunnel_config], Source={x:Static i18n:LocalizationManager.Instance}}">
                    <shadui:SidebarItem.Icon>
                        <common:LucideIcon Data="{x:Static common:AppIcons.Server}" Width="16" Height="16"/>
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>
                <shadui:SidebarItem Route="client.middleware" Content="{Binding [nav_middleware], Source={x:Static i18n:LocalizationManager.Instance}}">
                    <shadui:SidebarItem.Icon>
                        <common:LucideIcon Data="{x:Static common:AppIcons.SlidersHorizontal}" Width="16" Height="16"/>
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>
                <shadui:SidebarItem Route="client.logs" Content="{Binding [nav_logs], Source={x:Static i18n:LocalizationManager.Instance}}">
                    <shadui:SidebarItem.Icon>
                        <common:LucideIcon Data="{x:Static common:AppIcons.Terminal}" Width="16" Height="16"/>
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>
                <shadui:SidebarItem Route="settings" Content="{Binding [nav_settings], Source={x:Static i18n:LocalizationManager.Instance}}">
                    <shadui:SidebarItem.Icon>
                        <common:LucideIcon Data="{x:Static common:AppIcons.Settings}" Width="16" Height="16"/>
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>

                <!-- Admin Section -->
                <StackPanel Spacing="3">
                    <shadui:SidebarItemLabel AsSeparator="True" Text="{Binding [nav_admin], Source={x:Static i18n:LocalizationManager.Instance}}" />
                    <shadui:SidebarItem Route="admin.overview" Content="{Binding [nav_overview], Source={x:Static i18n:LocalizationManager.Instance}}">
                        <shadui:SidebarItem.Icon>
                            <common:LucideIcon Data="{x:Static common:AppIcons.Shield}" Width="16" Height="16"/>
                        </shadui:SidebarItem.Icon>
                    </shadui:SidebarItem>
                    <shadui:SidebarItem Route="admin.connections" Content="{Binding [nav_connections], Source={x:Static i18n:LocalizationManager.Instance}}">
                        <shadui:SidebarItem.Icon>
                            <common:LucideIcon Data="{x:Static common:AppIcons.Radio}" Width="16" Height="16"/>
                        </shadui:SidebarItem.Icon>
                    </shadui:SidebarItem>
                    <shadui:SidebarItem Route="admin.services" Content="{Binding [nav_services], Source={x:Static i18n:LocalizationManager.Instance}}">
                        <shadui:SidebarItem.Icon>
                            <common:LucideIcon Data="{x:Static common:AppIcons.Server}" Width="16" Height="16"/>
                        </shadui:SidebarItem.Icon>
                    </shadui:SidebarItem>
                    <shadui:SidebarItem Route="admin.users" Content="{Binding [nav_users], Source={x:Static i18n:LocalizationManager.Instance}}">
                        <shadui:SidebarItem.Icon>
                            <common:LucideIcon Data="{x:Static common:AppIcons.Users}" Width="16" Height="16"/>
                        </shadui:SidebarItem.Icon>
                    </shadui:SidebarItem>
                </StackPanel>
            </StackPanel>

            <shadui:Sidebar.Footer>
                <!-- Status & Connection state -->
                <Border Padding="6" Background="Transparent">
                    <Grid ColumnDefinitions="Auto, *">
                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="4,0,8,0"
                            Fill="{Binding NativeClient.CurrentStatus.Running, Converter={x:Static common:Converters.StatusToBrush}, FallbackValue='#6b7280'}"/>
                        <TextBlock Grid.Column="1"
                            Text="{Binding NativeClient.CurrentStatus.State, FallbackValue='IDLE'}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsSidebarExpanded}"/>
                    </Grid>
                </Border>
            </shadui:Sidebar.Footer>
        </shadui:Sidebar>

        <!-- Right: Current View Content Area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPageViewModel}"/>
    </Grid>
</shadui:Window>
