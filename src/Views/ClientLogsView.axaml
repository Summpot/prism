<UserControl
    x:Class="Prism.Views.ClientLogsView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:native="clr-namespace:Prism.Native"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    x:DataType="vm:ClientLogsViewModel"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto, *" Margin="{DynamicResource PageMargin}">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,24">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                <common:LucideIcon Data="{x:Static common:AppIcons.Terminal}" Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding [client_logs_title], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="h2" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                <!-- Level Filter Group (Segmented) -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ToggleButton Classes="Segment"
                                  IsChecked="{Binding FilterLevel, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=ALL, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="ALL" Content="ALL"/>
                    <ToggleButton Classes="Segment"
                                  IsChecked="{Binding FilterLevel, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=INFO, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="INFO" Content="INFO"/>
                    <ToggleButton Classes="Segment"
                                  IsChecked="{Binding FilterLevel, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=WARN, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="WARN" Content="WARN"/>
                    <ToggleButton Classes="Segment"
                                  IsChecked="{Binding FilterLevel, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=ERROR, Mode=OneWay}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="ERROR" Content="ERROR"/>
                </StackPanel>

                <!-- Search Input -->
                <TextBox
                    Text="{Binding SearchQuery, Mode=TwoWay}"
                    PlaceholderText="{Binding [client_logs_filter], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Width="120" />

                <!-- Action Tools -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <!-- Auto-Scroll Button -->
                    <Button Classes="Outline"
                            Width="32" Height="32" Padding="0"
                            Command="{Binding ToggleAutoScrollCommand}"
                            ToolTip.Tip="{Binding ScrollButtonText}">
                        <common:LucideIcon Data="{x:Static common:AppIcons.ArrowDownToLine}"
                                           Foreground="{Binding AutoScrollBrush}"
                                           Width="16" Height="16"/>
                    </Button>

                    <!-- Auto-Wrap Button -->
                    <Button Classes="Outline"
                            Width="32" Height="32" Padding="0"
                            Command="{Binding ToggleWordWrapCommand}"
                            ToolTip.Tip="{Binding WrapButtonText}">
                        <common:LucideIcon Data="{x:Static common:AppIcons.WrapText}"
                                           Foreground="{Binding WrapBrush}"
                                           Width="16" Height="16"/>
                    </Button>

                    <!-- Clear Logs Button -->
                    <Button Classes="Outline"
                            Width="32" Height="32" Padding="0"
                            Command="{Binding ClearLogsCommand}"
                            ToolTip.Tip="{Binding [client_logs_clear], Source={x:Static i18n:LocalizationManager.Instance}}">
                        <common:LucideIcon Data="{x:Static common:AppIcons.Trash2}"
                                           Foreground="{DynamicResource DestructiveColor}"
                                           Width="16" Height="16"/>
                    </Button>

                    <!-- Copy All Logs Button -->
                    <Button Classes="Outline"
                            Width="32" Height="32" Padding="0"
                            Command="{Binding CopyAllLogsCommand}"
                            ToolTip.Tip="{Binding CopyButtonText}">
                        <common:LucideIcon Data="{Binding CopiedAll, Converter={x:Static common:Converters.BoolToCopyOrCheckIcon}}"
                                           Foreground="{Binding CopiedAll, Converter={x:Static common:Converters.BoolToCopyOrCheckBrush}}"
                                           Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Terminal Viewport Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="{DynamicResource XlCornerRadius}"
                Padding="6"
                ClipToBounds="True">
            <Panel>
                <controls:EmptyState
                    IsVisible="{Binding IsEmpty}"
                    Icon="{x:Static common:AppIcons.Terminal}"
                    Title="{Binding [client_logs_empty], Source={x:Static i18n:LocalizationManager.Instance}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                <!-- Logs List Stream -->
                <ListBox
                    x:Name="LogsList"
                    Classes="LogList"
                    IsVisible="{Binding HasLogs}"
                    ItemsSource="{Binding FilteredLogs}"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="{Binding IsWordWrap, Converter={x:Static common:Converters.BoolToHorizontalScrollBarVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="native:ClientLogEntry">
                            <Grid ColumnDefinitions="Auto, Auto, Auto, *" Margin="0,1">
                                <!-- Timestamp -->
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding Timestamp, Converter={x:Static common:Converters.TimestampToTimeStr}}"
                                    FontFamily="{DynamicResource MonoFont}"
                                    Foreground="{DynamicResource MutedForegroundColor}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>

                                <!-- Level Badge -->
                                <Border
                                    Grid.Column="1"
                                    CornerRadius="{DynamicResource SmCornerRadius}"
                                    Background="{Binding Level, Converter={x:Static common:Converters.LogLevelToBackgroundBrush}}"
                                    BorderBrush="{Binding Level, Converter={x:Static common:Converters.LogLevelToBrush}}"
                                    BorderThickness="1"
                                    Padding="4,0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Level}" FontWeight="Bold"
                                               Foreground="{Binding Level, Converter={x:Static common:Converters.LogLevelToBrush}}"/>
                                </Border>

                                <!-- Target -->
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Target, StringFormat='{}{0}:'}"
                                    FontFamily="{DynamicResource MonoFont}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource MutedForegroundColor}"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"/>

                                <!-- Message -->
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding Message}"
                                    FontFamily="{DynamicResource MonoFont}"
                                    TextWrapping="{Binding #Root.((vm:ClientLogsViewModel)DataContext).IsWordWrap, Converter={x:Static common:Converters.BoolToTextWrapping}}"
                                    VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Floating Jump to Latest Button -->
                <Button
                    IsVisible="{Binding ShowScrollToBottom}"
                    Command="{Binding ScrollToBottomCommand}"
                    Classes="Primary"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <common:LucideIcon Data="{x:Static common:AppIcons.ArrowDown}" Width="16" Height="16" Foreground="{DynamicResource PrimaryForegroundColor}"/>
                        <TextBlock Text="{Binding [client_logs_latest], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Panel>
        </Border>
    </Grid>
</UserControl>
