{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Prism",
	"version": "0.1.0",
	"identifier": "com.prism.client",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:3000",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../../dist/client"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "Prism",
				"width": 980,
				"height": 720,
				"minWidth": 820,
				"minHeight": 580,
				"resizable": true,
				"fullscreen": false,
				"url": "_shell.html",
				"visible": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/icon.ico", "icons/icon.png"]
	}
}
