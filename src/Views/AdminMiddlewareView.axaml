<UserControl
    x:Class="Prism.Views.AdminMiddlewareView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:services="clr-namespace:Prism.Services"
    xmlns:native="clr-namespace:Prism.Native"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
    x:DataType="vm:AdminMiddlewareViewModel">

    <Panel>
    <controls:AdminReady State="{Binding ReadyState}" ConnectCommand="{Binding GoToConnectCommand}"
                         IsVisible="{Binding IsReady, Converter={x:Static common:Converters.BooleanNegation}}"/>
    <Grid RowDefinitions="Auto, *" Margin="{DynamicResource PageMargin}" IsVisible="{Binding IsReady}">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,24">
            <common:LucideIcon Data="{x:Static common:AppIcons.Sliders}" Width="16" Height="16" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding [admin_middleware_title], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="h2" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="260, 16, *">
        <!-- Left: Server Middleware List -->
        <shadui:Card Grid.Column="0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
                    <TextBlock Text="{Binding [middleware_selector], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="Small"/>
                    <TextBlock Text="{Binding [admin_middleware_subtitle], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" TextWrapping="Wrap"/>
                </StackPanel>

                <ListBox
                    ItemsSource="{Binding Middlewares}"
                    SelectedItem="{Binding SelectedMiddleware, Mode=TwoWay}"
                    Background="Transparent"
                    BorderThickness="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="CornerRadius" Value="6"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem /template/ PathIcon#CheckSelected">
                            <Setter Property="IsVisible" Value="False"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ PathIcon#CheckSelected">
                            <Setter Property="IsVisible" Value="False"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="services:AdminMiddlewareItem">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding EffectiveConfig.Count, Converter={x:Static common:Converters.SettingsCountLabel}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </shadui:Card>

        <!-- Right: Dynamic Schema Form -->
        <shadui:Card Grid.Column="2">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding SelectedMiddleware.Name}" Classes="Large" FontWeight="SemiBold"
                                           IsVisible="{Binding SelectedMiddleware, Converter={x:Static common:Converters.NotNullToBoolean}}"/>
                                <TextBlock Text="{Binding [middleware_select_placeholder], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="Large" FontWeight="SemiBold"
                                           IsVisible="{Binding SelectedMiddleware, Converter={x:Static common:Converters.NullToTrue}}"/>
                                <shadui:Badge Classes="Outline"
                                              Content="{Binding IsMiddlewareEnabled, Converter={x:Static common:Converters.ActiveStatusToLabel}}"
                                              Foreground="{Binding IsMiddlewareEnabled, Converter={x:Static common:Converters.ActiveStatusToBrush}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding [admin_middleware_schema_title], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsMiddlewareEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Background="{DynamicResource BorderColor}" Height="1"/>

                    <!-- Empty state -->
                    <TextBlock
                        IsVisible="{Binding ConfigFields.Count, Converter={x:Static common:Converters.EqualsZero}}"
                        Text="{Binding [middleware_no_schema_generic], Source={x:Static i18n:LocalizationManager.Instance}}"
                        Foreground="{DynamicResource MutedForegroundColor}"/>

                    <!-- Polymorphic Fields ItemsControl with DataTemplates -->
                    <ItemsControl ItemsSource="{Binding ConfigFields}">
                        <ItemsControl.DataTemplates>
                            <!-- Boolean field template -->
                            <DataTemplate DataType="vm:BoolMiddlewareFieldViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    <TextBlock
                                        IsVisible="{Binding Description, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                                        Text="{Binding Description}"
                                        Foreground="{DynamicResource MutedForegroundColor}"
                                        TextWrapping="Wrap"/>
                                    <ToggleSwitch IsChecked="{Binding Value, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataTemplate>

                            <!-- Numeric field template -->
                            <DataTemplate DataType="vm:NumberMiddlewareFieldViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    <TextBlock
                                        IsVisible="{Binding Description, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                                        Text="{Binding Description}"
                                        Foreground="{DynamicResource MutedForegroundColor}"
                                        TextWrapping="Wrap"/>
                                    <NumericUpDown Value="{Binding Value, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="vm:ListStringMiddlewareFieldViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    <TextBlock
                                        IsVisible="{Binding Description, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                                        Text="{Binding Description}"
                                        Foreground="{DynamicResource MutedForegroundColor}"
                                        TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding Value, Mode=TwoWay}" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>

                            <!-- String / generic field template -->
                            <DataTemplate DataType="vm:StringMiddlewareFieldViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    <TextBlock
                                        IsVisible="{Binding Description, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                                        Text="{Binding Description}"
                                        Foreground="{DynamicResource MutedForegroundColor}"
                                        TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding Value, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>

                    <Separator Background="{DynamicResource BorderColor}" Height="1"/>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="Outline" Command="{Binding ResetConfigCommand}" Content="{Binding [common_reset], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                        <Button Classes="Primary" Command="{Binding SaveConfigCommand}" Content="{Binding [common_save], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </shadui:Card>
        </Grid>
    </Grid>
    </Panel>
</UserControl>
