<UserControl
    x:Class="Prism.Views.AdminMiddlewareView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:services="clr-namespace:Prism.Services"
    xmlns:native="clr-namespace:Prism.Native"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
    x:DataType="vm:AdminMiddlewareViewModel">

    <Grid ColumnDefinitions="260, 16, *" Margin="16">
        <!-- Left: Server Middleware List -->
        <shadui:Card Grid.Column="0" Padding="12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="{Binding [nav_middleware], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{Binding [admin_middleware_subtitle], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}" TextWrapping="Wrap"/>
                </StackPanel>

                <ListBox
                    ItemsSource="{Binding Middlewares}"
                    SelectedItem="{Binding SelectedMiddleware, Mode=TwoWay}"
                    Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="services:AdminMiddlewareItem">
                            <Border Padding="8,6" CornerRadius="6">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding EffectiveConfig.Count, StringFormat='{}{0} settings configured'}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </shadui:Card>

        <!-- Right: Dynamic Schema Form -->
        <shadui:Card Grid.Column="2" Padding="16">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding SelectedMiddleware.Name, FallbackValue='Select a middleware'}" FontWeight="Bold" FontSize="16"/>
                                <shadui:Badge Content="{Binding IsMiddlewareEnabled, Converter={x:Static common:Converters.ActiveStatusToLabel}}"
                                              Background="{Binding IsMiddlewareEnabled, Converter={x:Static common:Converters.ActiveStatusToBrush}}"
                                              Foreground="White" Height="20" Padding="6,0" FontSize="10"/>
                            </StackPanel>
                            <TextBlock Text="{Binding [admin_middleware_schema_title], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsMiddlewareEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Background="{DynamicResource BorderColor}" Height="1"/>

                    <!-- Empty state -->
                    <TextBlock
                        IsVisible="{Binding ConfigFields.Count, Converter={x:Static common:Converters.EqualsZero}}"
                        Text="No configurable schema parameters for this middleware."
                        FontSize="12"
                        Foreground="{DynamicResource MutedForegroundColor}"/>

                    <!-- Polymorphic Fields ItemsControl with DataTemplates -->
                    <ItemsControl ItemsSource="{Binding ConfigFields}">
                        <ItemsControl.DataTemplates>
                            <!-- Boolean field template -->
                            <DataTemplate DataType="vm:BoolMiddlewareFieldViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock
                                        IsVisible="{Binding Description, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                                        Text="{Binding Description}"
                                        FontSize="11"
                                        Foreground="{DynamicResource MutedForegroundColor}"
                                        TextWrapping="Wrap"/>
                                    <ToggleSwitch IsChecked="{Binding Value, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataTemplate>

                            <!-- Numeric field template -->
                            <DataTemplate DataType="vm:NumberMiddlewareFieldViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock
                                        IsVisible="{Binding Description, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                                        Text="{Binding Description}"
                                        FontSize="11"
                                        Foreground="{DynamicResource MutedForegroundColor}"
                                        TextWrapping="Wrap"/>
                                    <NumericUpDown Value="{Binding Value, Mode=TwoWay}" Height="32" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>

                            <!-- String / generic field template -->
                            <DataTemplate DataType="vm:StringMiddlewareFieldViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock
                                        IsVisible="{Binding Description, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                                        Text="{Binding Description}"
                                        FontSize="11"
                                        Foreground="{DynamicResource MutedForegroundColor}"
                                        TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding Value, Mode=TwoWay}" Height="32" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>

                    <Separator Background="{DynamicResource BorderColor}" Height="1"/>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="Outline" Command="{Binding ResetConfigCommand}" Content="{Binding [common_reset], Source={x:Static i18n:LocalizationManager.Instance}}" Height="32" FontSize="12"/>
                        <Button Classes="Primary" Command="{Binding SaveConfigCommand}" Content="{Binding [common_save], Source={x:Static i18n:LocalizationManager.Instance}}" Height="32" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </shadui:Card>
    </Grid>
</UserControl>
