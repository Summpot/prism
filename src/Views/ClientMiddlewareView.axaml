<UserControl
    x:Class="Prism.Views.ClientMiddlewareView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:native="clr-namespace:Prism.Native"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
    x:DataType="vm:ClientMiddlewareViewModel">

    <Grid ColumnDefinitions="260, 16, *" Margin="16">
        <!-- Left: Middlewares List -->
        <shadui:Card Grid.Column="0" Padding="12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="{Binding [nav_middlewares], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="Installed client middlewares" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                </StackPanel>

                <ListBox
                    ItemsSource="{Binding Middlewares}"
                    SelectedItem="{Binding SelectedMiddleware, Mode=TwoWay}"
                    Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="native:MiddlewareItem">
                            <Border Padding="8,6" CornerRadius="6">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding EffectiveConfig.Count, StringFormat='{}{0} settings configured'}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </shadui:Card>

        <!-- Right: Dynamic Schema Form -->
        <shadui:Card Grid.Column="2" Padding="16">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding SelectedMiddleware.Name, FallbackValue='Select a middleware'}" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Configure parameters and behavior" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource BorderColor}" Height="1"/>

                    <!-- Empty state -->
                    <TextBlock
                        IsVisible="{Binding ConfigFields.Count, Converter={x:Static common:Converters.EqualsZero}}"
                        Text="No configurable schema parameters for this middleware."
                        FontSize="12"
                        Foreground="{DynamicResource MutedForegroundColor}"/>

                    <!-- Fields items -->
                    <ItemsControl ItemsSource="{Binding ConfigFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MiddlewareFieldItem">
                                <StackPanel Spacing="6" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock
                                        IsVisible="{Binding Description, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                                        Text="{Binding Description}"
                                        FontSize="11"
                                        Foreground="{DynamicResource MutedForegroundColor}"
                                        TextWrapping="Wrap"/>
                                    <TextBox
                                        Text="{Binding Value, Mode=TwoWay}"
                                        Height="32"
                                        FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button
                            Classes="Primary"
                            Command="{Binding SaveConfigCommand}"
                            Content="Save Configuration"
                            Height="32"
                            FontSize="12"
                            Padding="14,0"/>
                        <Button
                            Classes="Outline"
                            Command="{Binding ResetConfigCommand}"
                            Content="Reset Defaults"
                            Height="32"
                            FontSize="12"
                            Padding="14,0"/>
                    </StackPanel>

                    <!-- Status Notification -->
                    <TextBlock
                        IsVisible="{Binding StatusMessage, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                        Text="{Binding StatusMessage}"
                        Foreground="#10b981"
                        FontSize="12"/>
                </StackPanel>
            </ScrollViewer>
        </shadui:Card>
    </Grid>
</UserControl>
