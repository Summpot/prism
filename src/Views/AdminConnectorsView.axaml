<UserControl
    x:Class="Prism.Views.AdminConnectorsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:services="clr-namespace:Prism.Services"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
    x:DataType="vm:AdminConnectorsViewModel">

    <Panel>
    <controls:AdminReady State="{Binding ReadyState}" ConnectCommand="{Binding GoToConnectCommand}"
                         IsVisible="{Binding IsReady, Converter={x:Static common:Converters.BooleanNegation}}"/>
    <Grid RowDefinitions="Auto, Auto, *" Margin="{DynamicResource PageMargin}" IsVisible="{Binding IsReady}">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <common:LucideIcon Data="{x:Static common:AppIcons.Plug}" Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding [nav_connector_traffic], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="h4" VerticalAlignment="Center"/>
                <shadui:Badge Content="{Binding Connectors.Count}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox
                    Text="{Binding SearchQuery, Mode=TwoWay}"
                    PlaceholderText="{Binding [admin_connectors_filter], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Width="180"/>
                <Button Classes="Outline" Command="{Binding ToggleAutoRefreshCommand}">
                    <TextBlock Text="{Binding AutoRefreshText}"/>
                </Button>
                <Button Classes="Outline" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={x:Static common:Converters.BooleanNegation}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="16" Height="16"/>
                        <TextBlock Text="{Binding [common_refresh], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <controls:ErrorBanner
            Grid.Row="1"
            Message="{Binding ErrorMessage}"
            RetryCommand="{Binding RefreshCommand}"
            Margin="0,0,0,12"/>

        <Grid Grid.Row="2" RowDefinitions="*,Auto">
            <Grid Grid.Row="0">
                <DataGrid
                    ItemsSource="{Binding Connectors}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding [admin_col_client_id], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding ClientId}" MinWidth="130" Width="*"/>
                        <DataGridTextColumn Header="{Binding [admin_col_remote_addr], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding RemoteAddr}" MinWidth="130" Width="1.2*"/>
                        <DataGridTemplateColumn Header="{Binding [admin_col_role], Source={x:Static i18n:LocalizationManager.Instance}}" MinWidth="80" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ConnectorGroupItem">
                                    <shadui:Badge
                                        Content="{Binding Primary, Converter={x:Static common:Converters.PrimaryStandbyLabel}}"
                                        VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{Binding [admin_col_services], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding ServiceCount}" MinWidth="60" Width="75"/>
                        <DataGridTemplateColumn Header="{Binding [admin_col_published_services], Source={x:Static i18n:LocalizationManager.Instance}}" MinWidth="180" Width="1.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ConnectorGroupItem">
                                    <ItemsControl ItemsSource="{Binding Services}" Margin="0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="services:AdminRegisteredService">
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Proto, StringFormat='({0})'}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:EmptyState
                    IsVisible="{Binding Connectors.Count, Converter={x:Static common:Converters.EqualsZero}}"
                    Icon="{x:Static common:AppIcons.Radio}"
                    Title="{Binding [admin_no_active_connectors], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Margin="0,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

        <shadui:Card Grid.Row="1" Margin="0,16,0,0" IsVisible="{Binding Unattached.Count, Converter={x:Static common:Converters.NotEqualsZero}}">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding [admin_connectors_unattached], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding Unattached}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServiceRowItem">
                            <Grid ColumnDefinitions="160, 70, *, Auto, Auto" Margin="0,3">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Proto}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Remote}" FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding RoleText}" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="4" Text="{Binding RouteText}" Foreground="{DynamicResource MutedForegroundColor}" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </shadui:Card>
        </Grid>
    </Grid>
    </Panel>
</UserControl>
