<UserControl
    x:Class="Prism.Views.AdminConnectorsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:services="clr-namespace:Prism.Services"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
    x:DataType="vm:AdminConnectorsViewModel">

    <Grid RowDefinitions="Auto, Auto, *" Margin="20">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding [nav_connector_traffic], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="Bold" FontSize="20"/>
                    <shadui:Badge Content="{Binding Connectors.Count}" Height="20" Padding="6,0" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding [admin_connectors_subtitle], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox
                    Text="{Binding SearchQuery, Mode=TwoWay}"
                    PlaceholderText="{Binding [admin_connectors_filter], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Width="180"
                    Height="28"
                    FontSize="11"/>
                <Button Classes="Outline" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={x:Static common:Converters.BooleanNegation}}"
                        Height="28" Padding="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="12" Height="12"/>
                        <TextBlock Text="{Binding [common_refresh], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Error Banner -->
        <Border
            Grid.Row="1"
            IsVisible="{Binding ErrorMessage, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
            Background="#20ef4444"
            BorderBrush="#50ef4444"
            BorderThickness="1"
            CornerRadius="{DynamicResource MdCornerRadius}"
            Padding="12,8"
            Margin="0,0,0,12">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#ef4444" FontSize="12"/>
        </Border>

        <!-- Connectors List -->
        <shadui:Card Grid.Row="2" Padding="12">
            <Grid>
                <DataGrid
                    ItemsSource="{Binding Connectors}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Client ID" Binding="{Binding ClientId}" Width="160"/>
                        <DataGridTextColumn Header="Remote Address" Binding="{Binding RemoteAddr}" Width="*"/>
                        <DataGridTemplateColumn Header="Role" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ConnectorGroupItem">
                                    <shadui:Badge
                                        Content="{Binding Primary, Converter={x:Static common:Converters.BooleanToString}, ConverterParameter='Primary|Standby'}"
                                        Height="20"
                                        Padding="6,0"
                                        FontSize="10"
                                        VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Services" Binding="{Binding ServiceCount}" Width="80"/>
                        <DataGridTemplateColumn Header="Published Services" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ConnectorGroupItem">
                                    <ItemsControl ItemsSource="{Binding Services}" Margin="0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="services:AdminRegisteredService">
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"/>
                                                    <TextBlock Text="{Binding Proto, StringFormat='({0})'}" FontSize="10" Foreground="{DynamicResource MutedForegroundColor}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State -->
                <StackPanel
                    IsVisible="{Binding Connectors.Count, Converter={x:Static common:Converters.EqualsZero}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Margin="0,40">
                    <common:LucideIcon Data="{x:Static common:AppIcons.Radio}" Width="28" Height="28" Foreground="{DynamicResource MutedForegroundColor}"/>
                    <TextBlock Text="No active connectors found" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}"/>
                </StackPanel>
            </Grid>
        </shadui:Card>
    </Grid>
</UserControl>
