<UserControl
    x:Class="Prism.Views.ClientOptimizerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    x:DataType="vm:ClientOptimizerViewModel"
    mc:Ignorable="d">

    <DockPanel>
        <Grid
            DockPanel.Dock="Top"
            ColumnDefinitions="*, Auto"
            Margin="{DynamicResource PageMargin}"
            MaxWidth="{DynamicResource PageMaxWidth}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <common:LucideIcon Data="{x:Static common:AppIcons.Zap}" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding [optimizer_title], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="h2" VerticalAlignment="Center"/>
                    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OptimizerEnabled, Converter={x:Static common:Converters.ActiveStatusToLabel}}"
                                   Classes="Caption"
                                   Foreground="{Binding OptimizerEnabled, Converter={x:Static common:Converters.ActiveStatusToBrush}}"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="Outline" Command="{Binding GoToTrafficCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <common:LucideIcon Data="{x:Static common:AppIcons.Activity}" Width="16" Height="16" Foreground="{DynamicResource SuccessColor}"/>
                            <TextBlock Text="{Binding [nav_traffic], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="Outline" Command="{Binding ResetDefaultsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="16" Height="16"/>
                            <TextBlock Text="{Binding [client_reset], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                        </StackPanel>
                    </Button>
                    <StackPanel IsVisible="{Binding SavedNotice}" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <common:LucideIcon Data="{x:Static common:AppIcons.Check}" Width="16" Height="16" Foreground="{DynamicResource SuccessColor}"/>
                        <TextBlock Text="{Binding [optimizer_save_success], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource SuccessColor}" FontWeight="Medium"/>
                    </StackPanel>
                </StackPanel>
        </Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{DynamicResource PageMaxWidth}" Spacing="16" Margin="{DynamicResource PageContentMargin}">

            <!-- Card 0: Quick Presets -->
            <shadui:Card>
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [optimizer_presets_title], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [optimizer_presets_desc], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ToggleButton Classes="Segment"
                                      IsChecked="{Binding ActivePreset, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=gaming, Mode=OneWay}"
                                      Command="{Binding ApplyPresetCommand}" CommandParameter="gaming">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <common:LucideIcon Data="{x:Static common:AppIcons.Gamepad2}" Width="16" Height="16"/>
                                <TextBlock Text="{Binding [optimizer_preset_gaming], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Classes="Segment"
                                      IsChecked="{Binding ActivePreset, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=low_latency, Mode=OneWay}"
                                      Command="{Binding ApplyPresetCommand}" CommandParameter="low_latency">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <common:LucideIcon Data="{x:Static common:AppIcons.Zap}" Width="16" Height="16"/>
                                <TextBlock Text="{Binding [optimizer_preset_low_latency], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Classes="Segment"
                                      IsChecked="{Binding ActivePreset, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=balanced, Mode=OneWay}"
                                      Command="{Binding ApplyPresetCommand}" CommandParameter="balanced">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <common:LucideIcon Data="{x:Static common:AppIcons.Activity}" Width="16" Height="16"/>
                                <TextBlock Text="{Binding [optimizer_preset_balanced], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Classes="Segment"
                                      IsChecked="{Binding ActivePreset, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=max_compression, Mode=OneWay}"
                                      Command="{Binding ApplyPresetCommand}" CommandParameter="max_compression">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <common:LucideIcon Data="{x:Static common:AppIcons.ArrowDown}" Width="16" Height="16"/>
                                <TextBlock Text="{Binding [optimizer_preset_max_save], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </shadui:Card>

            <!-- 2-Column: Master Switch Card & Compression Level Card -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <!-- Left: Master Switch Card -->
                <shadui:Card Grid.Column="0">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <common:LucideIcon Data="{x:Static common:AppIcons.Zap}" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}"/>
                                    <TextBlock Text="{Binding [optimizer_general_card], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding [optimizer_general_card_hint], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding OptimizerEnabled, Mode=TwoWay}"/>
                        </Grid>

                        <Border Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="10" Margin="0,4,0,0">
                            <TextBlock Text="{Binding [optimizer_enabled_hint], Source={x:Static i18n:LocalizationManager.Instance}}"
                                       Foreground="{DynamicResource MutedForegroundColor}"
                                       TextWrapping="Wrap"
                                       LineHeight="16"/>
                        </Border>
                    </StackPanel>
                </shadui:Card>

                <!-- Right: Zstandard Compression Level Card -->
                <shadui:Card Grid.Column="1" IsEnabled="{Binding OptimizerEnabled}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <common:LucideIcon Data="{x:Static common:AppIcons.Cpu}" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}"/>
                                    <TextBlock Text="{Binding [optimizer_compression_card], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding [optimizer_compression_card_hint], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="Large" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"
                                       Text="{Binding OptimizerZstdLevel}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding [optimizer_level_label], Source={x:Static i18n:LocalizationManager.Instance}}" VerticalAlignment="Center"/>
                            <ToggleButton Classes="Segment"
                                          IsChecked="{Binding OptimizerZstdLevel, Converter={x:Static common:Converters.IntEquals}, ConverterParameter=1, Mode=OneWay}"
                                          Command="{Binding SetLevelCommand}" CommandParameter="1" Content="1"/>
                            <ToggleButton Classes="Segment"
                                          IsChecked="{Binding OptimizerZstdLevel, Converter={x:Static common:Converters.IntEquals}, ConverterParameter=3, Mode=OneWay}"
                                          Command="{Binding SetLevelCommand}" CommandParameter="3" Content="3"/>
                            <ToggleButton Classes="Segment"
                                          IsChecked="{Binding OptimizerZstdLevel, Converter={x:Static common:Converters.IntEquals}, ConverterParameter=5, Mode=OneWay}"
                                          Command="{Binding SetLevelCommand}" CommandParameter="5" Content="5"/>
                            <ToggleButton Classes="Segment"
                                          IsChecked="{Binding OptimizerZstdLevel, Converter={x:Static common:Converters.IntEquals}, ConverterParameter=9, Mode=OneWay}"
                                          Command="{Binding SetLevelCommand}" CommandParameter="9" Content="9"/>
                        </StackPanel>

                        <Slider Minimum="1" Maximum="19" Value="{Binding OptimizerZstdLevel, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding [optimizer_level_hint], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                    </StackPanel>
                </shadui:Card>
            </Grid>

            <!-- Card 3: Batching & Latency Control Card -->
            <shadui:Card IsEnabled="{Binding OptimizerEnabled}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <common:LucideIcon Data="{x:Static common:AppIcons.Gauge}" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}"/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding [optimizer_batching_card], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding [optimizer_batching_card_hint], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnDefinitions="*, 8, *, 8, *" Margin="0,4,0,0">
                        <!-- Adaptive Flush -->
                        <Border Grid.Column="0" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding [optimizer_adaptive_flush_label], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding OptimizerAdaptiveFlush, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock Text="{Binding [optimizer_adaptive_flush_hint], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Base Flush Interval -->
                        <Border Grid.Column="2" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding [optimizer_flush_interval_label], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="Medium"/>
                                    <Border Grid.Column="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,0">
                                        <TextBlock Text="{Binding OptimizerFlushIntervalMs, StringFormat='{}{0} ms'}" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                    </Border>
                                </Grid>
                                <Slider Minimum="2" Maximum="60" Value="{Binding OptimizerFlushIntervalMs, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding [optimizer_flush_interval_hint], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Buffer Threshold -->
                        <Border Grid.Column="4" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding [optimizer_buffer_threshold_label], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="Medium"/>
                                    <Border Grid.Column="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource SmCornerRadius}" Padding="4,0">
                                        <TextBlock Text="{Binding OptimizerBufferThreshold, StringFormat='{}{0} B'}" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                    </Border>
                                </Grid>
                                <Slider Minimum="4096" Maximum="262144" SmallChange="4096" LargeChange="16384" Value="{Binding OptimizerBufferThreshold, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding [optimizer_buffer_threshold_hint], Source={x:Static i18n:LocalizationManager.Instance}}" Foreground="{DynamicResource MutedForegroundColor}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </shadui:Card>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
