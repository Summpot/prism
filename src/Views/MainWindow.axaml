<shadui:Window
    x:Class="Prism.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:views="clr-namespace:Prism.Views"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:common="clr-namespace:Prism.Common"
    Title="Prism"
    Width="1100"
    Height="740"
    MinWidth="880"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:DataType="vm:MainWindowViewModel">

    <shadui:Window.Hosts>
        <shadui:DialogHost Manager="{Binding DialogManager}" x:Name="PART_DialogHost" />
        <shadui:ToastHost Manager="{Binding ToastManager}" />
    </shadui:Window.Hosts>

    <shadui:Window.DataTemplates>
        <DataTemplate DataType="vm:ClientOverviewViewModel">
            <views:ClientOverviewView />
        </DataTemplate>
        <DataTemplate DataType="vm:ClientTrafficViewModel">
            <views:ClientTrafficView />
        </DataTemplate>
        <DataTemplate DataType="vm:ClientLogsViewModel">
            <views:ClientLogsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ClientProfilesViewModel">
            <views:ClientProfilesView />
        </DataTemplate>
        <DataTemplate DataType="vm:ClientMiddlewareViewModel">
            <views:ClientMiddlewareView />
        </DataTemplate>
        <DataTemplate DataType="vm:ClientOptimizerViewModel">
            <views:ClientOptimizerView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:AdminOverviewViewModel">
            <views:AdminOverviewView />
        </DataTemplate>
        <DataTemplate DataType="vm:AdminConnectionsViewModel">
            <views:AdminConnectionsView />
        </DataTemplate>
        <DataTemplate DataType="vm:AdminTunnelServicesViewModel">
            <views:AdminTunnelServicesView />
        </DataTemplate>
        <DataTemplate DataType="vm:AdminTrafficViewModel">
            <views:AdminTrafficView />
        </DataTemplate>
        <DataTemplate DataType="vm:AdminConnectorsViewModel">
            <views:AdminConnectorsView />
        </DataTemplate>
        <DataTemplate DataType="vm:AdminMiddlewareViewModel">
            <views:AdminMiddlewareView />
        </DataTemplate>
        <DataTemplate DataType="vm:AdminRuntimeViewModel">
            <views:AdminRuntimeView />
        </DataTemplate>
        <DataTemplate DataType="vm:AdminUsersViewModel">
            <views:AdminUsersView />
        </DataTemplate>
    </shadui:Window.DataTemplates>

    <shadui:Window.RightWindowTitleBarContent>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0" VerticalAlignment="Center">
            <!-- Language Switcher Flyout Button -->
            <Button Classes="Ghost" Height="26" Padding="6,2" CornerRadius="4">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <common:LucideIcon Data="{x:Static common:AppIcons.Languages}" Width="13" Height="13" Foreground="{DynamicResource MutedForegroundColor}"/>
                    <TextBlock Text="{Binding CurrentLocale, Converter={x:Static common:Converters.LocaleToShortLabel}}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="{Binding [language_chinese], Source={x:Static i18n:LocalizationManager.Instance}}" Command="{Binding SelectLocaleCommand}" CommandParameter="zh-CN">
                            <MenuItem.Icon>
                                <common:LucideIcon Data="{x:Static common:AppIcons.Check}" Width="12" Height="12" IsVisible="{Binding CurrentLocale, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=zh-CN}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Binding [language_english], Source={x:Static i18n:LocalizationManager.Instance}}" Command="{Binding SelectLocaleCommand}" CommandParameter="en">
                            <MenuItem.Icon>
                                <common:LucideIcon Data="{x:Static common:AppIcons.Check}" Width="12" Height="12" IsVisible="{Binding CurrentLocale, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=en}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </shadui:Window.RightWindowTitleBarContent>

    <Grid ColumnDefinitions="Auto, *">
        <!-- Sidebar Navigation -->
        <shadui:Sidebar
            Grid.Column="0"
            CurrentRoute="{Binding Navigation.CurrentRoute, Mode=TwoWay}"
            Expanded="{Binding IsSidebarExpanded, Mode=TwoWay}"
            Width="{Binding IsSidebarExpanded, Converter={x:Static common:Converters.ExpandedSidebarWidth}}"
            MinWidth="56">
            <shadui:Sidebar.Header>
                <Grid Margin="4,0">
                    <!-- Expanded Header -->
                    <Grid ColumnDefinitions="Auto, *, Auto" IsVisible="{Binding IsSidebarExpanded}">
                        <Image Grid.Column="0" Source="avares://Prism/Assets/logo192.png" Width="24" Height="24" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Prism" FontWeight="Bold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Classes="Ghost" Command="{Binding ToggleSidebarCommand}" Width="28" Height="28" Padding="4">
                            <common:LucideIcon Data="{x:Static common:AppIcons.PanelLeft}" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                    <!-- Collapsed Header -->
                    <Button Classes="Ghost" Command="{Binding ToggleSidebarCommand}" Width="32" Height="32" Padding="4" HorizontalAlignment="Center" IsVisible="{Binding !IsSidebarExpanded}">
                        <Image Source="avares://Prism/Assets/logo192.png" Width="22" Height="22"/>
                    </Button>
                </Grid>
            </shadui:Sidebar.Header>

            <StackPanel Spacing="3">
                <shadui:SidebarItemLabel AsSeparator="True" Text="{Binding [nav_client], Source={x:Static i18n:LocalizationManager.Instance}}" />
                
                <shadui:SidebarItem 
                    Route="client.overview" 
                    Content="{Binding [nav_connection], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="client.overview">
                    <shadui:SidebarItem.Icon>
                        <common:LucideIcon Data="{x:Static common:AppIcons.Gamepad2}" Width="16" Height="16"/>
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>

                <shadui:SidebarItem 
                    Route="client.traffic" 
                    Content="{Binding [nav_traffic], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="client.traffic">
                    <shadui:SidebarItem.Icon>
                        <common:LucideIcon Data="{x:Static common:AppIcons.ArrowDownUp}" Width="16" Height="16"/>
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>

                <shadui:SidebarItem 
                    Route="client.logs" 
                    Content="{Binding [nav_logs], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="client.logs">
                    <shadui:SidebarItem.Icon>
                        <common:LucideIcon Data="{x:Static common:AppIcons.Terminal}" Width="16" Height="16"/>
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>

                <shadui:SidebarItem 
                    Route="client.profiles" 
                    Content="{Binding [nav_tunnel_config], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="client.profiles">
                    <shadui:SidebarItem.Icon>
                        <common:LucideIcon Data="{x:Static common:AppIcons.SlidersHorizontal}" Width="16" Height="16"/>
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>

                <shadui:SidebarItem 
                    Route="client.middleware" 
                    Content="{Binding [nav_middleware], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="client.middleware">
                    <shadui:SidebarItem.Icon>
                        <common:LucideIcon Data="{x:Static common:AppIcons.Sliders}" Width="16" Height="16"/>
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>

                <shadui:SidebarItem 
                    Route="client.optimizer" 
                    Content="{Binding [nav_optimizer], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="client.optimizer">
                    <shadui:SidebarItem.Icon>
                        <common:LucideIcon Data="{x:Static common:AppIcons.Zap}" Width="16" Height="16"/>
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>

                <!-- Admin Section (Shown when IsAdmin is true) -->
                <StackPanel Spacing="3" IsVisible="{Binding IsAdmin}">
                    <shadui:SidebarItemLabel AsSeparator="True" Text="{Binding [nav_admin], Source={x:Static i18n:LocalizationManager.Instance}}" />
                    
                    <shadui:SidebarItem 
                        Route="admin.overview" 
                        Content="{Binding [nav_overview], Source={x:Static i18n:LocalizationManager.Instance}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="admin.overview">
                        <shadui:SidebarItem.Icon>
                            <common:LucideIcon Data="{x:Static common:AppIcons.Activity}" Width="16" Height="16"/>
                        </shadui:SidebarItem.Icon>
                    </shadui:SidebarItem>

                    <shadui:SidebarItem 
                        Route="admin.connections" 
                        Content="{Binding [nav_connections], Source={x:Static i18n:LocalizationManager.Instance}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="admin.connections">
                        <shadui:SidebarItem.Icon>
                            <common:LucideIcon Data="{x:Static common:AppIcons.Cable}" Width="16" Height="16"/>
                        </shadui:SidebarItem.Icon>
                    </shadui:SidebarItem>

                    <shadui:SidebarItem 
                        Route="admin.services" 
                        Content="{Binding [nav_services], Source={x:Static i18n:LocalizationManager.Instance}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="admin.services">
                        <shadui:SidebarItem.Icon>
                            <common:LucideIcon Data="{x:Static common:AppIcons.Unplug}" Width="16" Height="16"/>
                        </shadui:SidebarItem.Icon>
                    </shadui:SidebarItem>

                    <shadui:SidebarItem 
                        Route="admin.traffic" 
                        Content="{Binding [nav_server_traffic], Source={x:Static i18n:LocalizationManager.Instance}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="admin.traffic">
                        <shadui:SidebarItem.Icon>
                            <common:LucideIcon Data="{x:Static common:AppIcons.Server}" Width="16" Height="16"/>
                        </shadui:SidebarItem.Icon>
                    </shadui:SidebarItem>

                    <shadui:SidebarItem 
                        Route="admin.connectors" 
                        Content="{Binding [nav_connector_traffic], Source={x:Static i18n:LocalizationManager.Instance}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="admin.connectors">
                        <shadui:SidebarItem.Icon>
                            <common:LucideIcon Data="{x:Static common:AppIcons.Radio}" Width="16" Height="16"/>
                        </shadui:SidebarItem.Icon>
                    </shadui:SidebarItem>

                    <shadui:SidebarItem 
                        Route="admin.middleware" 
                        Content="{Binding [nav_middleware], Source={x:Static i18n:LocalizationManager.Instance}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="admin.middleware">
                        <shadui:SidebarItem.Icon>
                            <common:LucideIcon Data="{x:Static common:AppIcons.SlidersHorizontal}" Width="16" Height="16"/>
                        </shadui:SidebarItem.Icon>
                    </shadui:SidebarItem>

                    <shadui:SidebarItem 
                        Route="admin.runtime" 
                        Content="{Binding [nav_runtime], Source={x:Static i18n:LocalizationManager.Instance}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="admin.runtime">
                        <shadui:SidebarItem.Icon>
                            <common:LucideIcon Data="{x:Static common:AppIcons.Gauge}" Width="16" Height="16"/>
                        </shadui:SidebarItem.Icon>
                    </shadui:SidebarItem>

                    <shadui:SidebarItem 
                        Route="admin.users" 
                        Content="{Binding [nav_users], Source={x:Static i18n:LocalizationManager.Instance}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="admin.users">
                        <shadui:SidebarItem.Icon>
                            <common:LucideIcon Data="{x:Static common:AppIcons.Users}" Width="16" Height="16"/>
                        </shadui:SidebarItem.Icon>
                    </shadui:SidebarItem>
                </StackPanel>
            </StackPanel>

            <shadui:Sidebar.Footer>
                <shadui:SidebarItem 
                    Route="settings" 
                    Content="{Binding [nav_settings], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="settings">
                    <shadui:SidebarItem.Icon>
                        <common:LucideIcon Data="{x:Static common:AppIcons.Settings}" Width="16" Height="16"/>
                    </shadui:SidebarItem.Icon>
                </shadui:SidebarItem>
            </shadui:Sidebar.Footer>
        </shadui:Sidebar>

        <!-- Right: Current View Content Area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPageViewModel}"/>
    </Grid>
</shadui:Window>
