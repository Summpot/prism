<UserControl
    x:Class="Prism.Views.EditUserDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:i18n="clr-namespace:Prism.I18n"
    x:DataType="vm:EditUserDialogContext"
    MinWidth="460">
    <StackPanel Spacing="10" Margin="4">
        <TextBlock Text="{Binding Owner.EditUserTitle}" FontWeight="Bold" FontSize="13"/>
        <TextBlock Text="{Binding [users_edit_description], Source={x:Static i18n:LocalizationManager.Instance}}"
                   FontSize="11" TextWrapping="Wrap" Opacity="0.75"/>

        <TextBlock Text="{Binding [users_role], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold"/>
        <ComboBox ItemsSource="{x:Static vm:AdminUsersViewModel.AvailableRoles}"
                  SelectedItem="{Binding Owner.EditRole, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" Height="30" FontSize="11">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={x:Static common:Converters.RoleLabel}}" FontSize="11"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="{Binding [users_rules_label], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold"/>
        <TextBox Text="{Binding Owner.EditServiceRules, Mode=TwoWay}"
                 AcceptsReturn="True" Height="72" FontSize="11"
                 FontFamily="{DynamicResource MonoFont}"
                 PlaceholderText="{Binding [admin_users_service_rules_hint], Source={x:Static i18n:LocalizationManager.Instance}}"/>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="Outline" Command="{Binding Owner.CloseEditUserDialogCommand}"
                    Content="{Binding [common_cancel], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Height="30" FontSize="11" Padding="12,0"/>
            <Button Classes="Primary" Command="{Binding Owner.SaveUserChangesCommand}"
                    Content="{Binding [users_save_changes], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Height="30" FontSize="11" Padding="12,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
