<UserControl
    x:Class="Prism.Views.CreateTokenDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    x:DataType="vm:TokenDialogContext">
    <StackPanel Spacing="16" Margin="24" Width="460">
        <TextBlock Classes="h4" Text="{Binding [users_token_modal_title], Source={x:Static i18n:LocalizationManager.Instance}}"/>
        <TextBlock Classes="Caption Muted" TextWrapping="Wrap"
                   Text="{Binding [users_token_modal_description], Source={x:Static i18n:LocalizationManager.Instance}}"/>

        <TextBox Text="{Binding Owner.NewTokenName, Mode=TwoWay}"
                 PlaceholderText="{Binding [users_token_name_placeholder], Source={x:Static i18n:LocalizationManager.Instance}}"
                 shadui:ControlAssist.Label="{Binding [users_token_name], Source={x:Static i18n:LocalizationManager.Instance}}"/>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Owner.TokenTypeValues}"
                      SelectedItem="{Binding Owner.NewTokenType, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      shadui:ControlAssist.Label="{Binding [users_token_type], Source={x:Static i18n:LocalizationManager.Instance}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static common:Converters.TokenTypeLabel}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="1"
                      ItemsSource="{x:Static vm:AdminUsersViewModel.ExpirationOptions}"
                      SelectedItem="{Binding Owner.SelectedExpirationDays, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      shadui:ControlAssist.Label="{Binding [users_token_expiry], Source={x:Static i18n:LocalizationManager.Instance}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static common:Converters.ExpirationDaysLabel}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <ComboBox ItemsSource="{Binding Owner.Users}"
                  SelectedValue="{Binding Owner.SelectedUserId, Mode=TwoWay}"
                  SelectedValueBinding="{Binding Id, x:DataType=vm:UserRowItem}"
                  DisplayMemberBinding="{Binding Username, x:DataType=vm:UserRowItem}"
                  HorizontalAlignment="Stretch"
                  shadui:ControlAssist.Label="{Binding [admin_col_username], Source={x:Static i18n:LocalizationManager.Instance}}"/>

        <Border IsVisible="{Binding Owner.CreatedRawToken, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                Background="{DynamicResource SuccessColor10}"
                BorderBrush="{DynamicResource SuccessColor}"
                BorderThickness="1"
                CornerRadius="{DynamicResource MdCornerRadius}"
                Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Classes="Small" FontWeight="SemiBold" Foreground="{DynamicResource SuccessColor}"
                           Text="{Binding [users_token_copy_hint], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding Owner.CreatedRawToken}" IsReadOnly="True"
                             FontFamily="{DynamicResource MonoFont}"/>
                    <Button Grid.Column="1" Classes="Outline" Command="{Binding Owner.CopyRawTokenCommand}"
                            Content="{Binding [client_copy], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Margin="0,24,0,0" Spacing="16">
            <Button Classes="Primary"
                    Command="{Binding Owner.SubmitCreateTokenCommand}"
                    HotKey="Enter"
                    Content="{Binding [users_token_generate], Source={x:Static i18n:LocalizationManager.Instance}}"/>
            <Button Classes="Outline"
                    Command="{Binding Owner.CloseCreateTokenDialogCommand}"
                    HotKey="Escape"
                    Content="{Binding [common_cancel], Source={x:Static i18n:LocalizationManager.Instance}}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
