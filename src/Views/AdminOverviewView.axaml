<UserControl
    x:Class="Prism.Views.AdminOverviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
    x:DataType="vm:AdminOverviewViewModel">

    <Panel>
    <controls:AdminReady
        State="{Binding ReadyState}"
        ConnectCommand="{Binding GoToConnectCommand}"
        IsVisible="{Binding IsReady, Converter={x:Static common:Converters.BooleanNegation}}"/>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="16"
                  IsVisible="{Binding IsReady}">
        <StackPanel Spacing="12" MaxWidth="960" HorizontalAlignment="Left">
            <controls:PageHeader
                Title="{Binding [nav_overview], Source={x:Static i18n:LocalizationManager.Instance}}"
                Description="{Binding [dashboard_description], Source={x:Static i18n:LocalizationManager.Instance}}"
                Icon="{x:Static common:AppIcons.Activity}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="Outline" Command="{Binding ToggleAutoRefreshCommand}" Height="28" Padding="10,0">
                        <TextBlock Text="{Binding AutoRefreshText}" FontSize="11"/>
                    </Button>
                    <Button Classes="Outline" Command="{Binding LoadDataCommand}"
                            IsEnabled="{Binding IsLoading, Converter={x:Static common:Converters.BooleanNegation}}"
                            Height="28" Padding="10,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="12" Height="12"/>
                            <TextBlock Text="{Binding [common_refresh], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:PageHeader>

            <controls:ErrorBanner Message="{Binding ErrorMessage}" RetryCommand="{Binding LoadDataCommand}"/>

            <!-- Metrics Grid -->
            <Grid ColumnDefinitions="*, 12, *, 12, *, 12, *" Margin="0,4,0,0">
                <!-- Active Connections -->
                <shadui:Card Grid.Column="0" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding [dashboard_active_connections], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                        <TextBlock Text="{Binding ConnectionCount}" FontWeight="Bold" FontSize="24"/>
                        <TextBlock Text="{Binding [admin_overview_total_tunnels], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="10" Foreground="{DynamicResource MutedForegroundColor}"/>
                    </StackPanel>
                </shadui:Card>

                <!-- Registered Services -->
                <shadui:Card Grid.Column="2" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding [dashboard_tunnel_services], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                        <TextBlock Text="{Binding ServiceCount}" FontWeight="Bold" FontSize="24"/>
                        <TextBlock Text="{Binding [admin_overview_route_targets], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="10" Foreground="{DynamicResource MutedForegroundColor}"/>
                    </StackPanel>
                </shadui:Card>

                <shadui:Card Grid.Column="4" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding [dashboard_optimizer_savings], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                        <TextBlock Text="{Binding SavedRatioText}" FontWeight="Bold" FontSize="24"/>
                    </StackPanel>
                </shadui:Card>

                <!-- Server Status -->
                <shadui:Card Grid.Column="6" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding [admin_overview_node_state], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding IsHealthy, Converter={x:Static common:Converters.StatusToBrush}}"
                                     VerticalAlignment="Center"/>
                            <TextBlock
                                Text="{Binding IsHealthy, Converter={x:Static common:Converters.StatusToLabel}}"
                                FontWeight="Bold"
                                FontSize="18"
                                Foreground="{Binding IsHealthy, Converter={x:Static common:Converters.StatusToBrush}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding [admin_overview_control_active], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="10" Foreground="{DynamicResource MutedForegroundColor}"/>
                    </StackPanel>
                </shadui:Card>
            </Grid>

            <!-- Configuration Card -->
            <shadui:Card Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [admin_overview_config_ops], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                    
                    <Grid ColumnDefinitions="140, *">
                        <TextBlock Grid.Column="0" Text="{Binding [dashboard_config_file], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ConfigPath}" FontFamily="Consolas, monospace" FontSize="12"/>
                    </Grid>

                    <Separator Background="{DynamicResource BorderColor}" Height="1"/>

                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding [admin_overview_hot_reload], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="{Binding [admin_overview_hot_reload_desc], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Classes="Outline"
                            Command="{Binding ReloadServerCommand}"
                            Content="{Binding [admin_reload], Source={x:Static i18n:LocalizationManager.Instance}}"
                            Height="32"
                            FontSize="12"
                            Padding="14,0"/>
                    </Grid>

                    <TextBlock
                        IsVisible="{Binding ReloadMessage, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                        Text="{Binding ReloadMessage}"
                        Foreground="#10b981"
                        FontSize="11"/>
                </StackPanel>
            </shadui:Card>
        </StackPanel>
    </ScrollViewer>
    </Panel>
</UserControl>
