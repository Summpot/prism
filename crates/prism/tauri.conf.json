{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Prism",
	"version": "0.1.0",
	"identifier": "com.prism.client",
	"build": {
		"frontendDist": "frontend-dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "Prism Client",
				"width": 980,
				"height": 720,
				"minWidth": 820,
				"minHeight": 580,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/icon.ico", "icons/icon.png"]
	}
}
