<UserControl
    x:Class="Prism.Views.AdminOverviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
    x:DataType="vm:AdminOverviewViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="20">
        <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
            <!-- Header with Refresh -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding [nav_overview], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="Bold" FontSize="20"/>
                    <TextBlock Text="{Binding [dashboard_description], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="Outline" Command="{Binding LoadDataCommand}"
                        IsEnabled="{Binding IsLoading, Converter={x:Static common:Converters.BooleanNegation}}"
                        Height="28" Padding="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="12" Height="12"/>
                        <TextBlock Text="{Binding [common_refresh], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Error Banner -->
            <Border
                IsVisible="{Binding ErrorMessage, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                Background="#20ef4444"
                BorderBrush="#50ef4444"
                BorderThickness="1"
                CornerRadius="{DynamicResource MdCornerRadius}"
                Padding="12,8">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#ef4444" FontSize="12"/>
            </Border>

            <!-- Metrics Grid -->
            <Grid ColumnDefinitions="*, 12, *, 12, *" Margin="0,4,0,0">
                <!-- Active Connections -->
                <shadui:Card Grid.Column="0" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding [dashboard_active_connections], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                        <TextBlock Text="{Binding ConnectionCount}" FontWeight="Bold" FontSize="24"/>
                        <TextBlock Text="Total client tunnels attached" FontSize="10" Foreground="{DynamicResource MutedForegroundColor}"/>
                    </StackPanel>
                </shadui:Card>

                <!-- Registered Services -->
                <shadui:Card Grid.Column="2" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding [dashboard_tunnel_services], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                        <TextBlock Text="{Binding ServiceCount}" FontWeight="Bold" FontSize="24"/>
                        <TextBlock Text="TCP / UDP route targets" FontSize="10" Foreground="{DynamicResource MutedForegroundColor}"/>
                    </StackPanel>
                </shadui:Card>

                <!-- Server Status -->
                <shadui:Card Grid.Column="4" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Node State" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding IsHealthy, Converter={x:Static common:Converters.StatusToBrush}}"
                                     VerticalAlignment="Center"/>
                            <TextBlock
                                Text="{Binding IsHealthy, Converter={x:Static common:Converters.StatusToLabel}}"
                                FontWeight="Bold"
                                FontSize="18"
                                Foreground="{Binding IsHealthy, Converter={x:Static common:Converters.StatusToBrush}}"/>
                        </StackPanel>
                        <TextBlock Text="Control plane active" FontSize="10" Foreground="{DynamicResource MutedForegroundColor}"/>
                    </StackPanel>
                </shadui:Card>
            </Grid>

            <!-- Configuration Card -->
            <shadui:Card Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Configuration &amp; Runtime Operations" FontWeight="SemiBold" FontSize="14"/>
                    
                    <Grid ColumnDefinitions="140, *">
                        <TextBlock Grid.Column="0" Text="Config File:" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ConfigPath}" FontFamily="Consolas, monospace" FontSize="12"/>
                    </Grid>

                    <Separator Background="{DynamicResource BorderColor}" Height="1"/>

                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Hot Reload Configuration" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Reload prism.toml and refresh tunnel routes without dropping active connections" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Classes="Outline"
                            Command="{Binding ReloadServerCommand}"
                            Content="Reload Config"
                            Height="32"
                            FontSize="12"
                            Padding="14,0"/>
                    </Grid>

                    <TextBlock
                        IsVisible="{Binding ReloadMessage, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                        Text="{Binding ReloadMessage}"
                        Foreground="#10b981"
                        FontSize="11"/>
                </StackPanel>
            </shadui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
