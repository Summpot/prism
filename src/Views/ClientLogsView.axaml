<UserControl
    x:Class="Prism.Views.ClientLogsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:native="clr-namespace:Prism.Native"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    x:DataType="vm:ClientLogsViewModel"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto, *" Margin="16">
        <controls:PageHeader
            Grid.Row="0"
            Title="{Binding [client_logs_title], Source={x:Static i18n:LocalizationManager.Instance}}"
            Description="{Binding [client_logs_description], Source={x:Static i18n:LocalizationManager.Instance}}"
            Icon="{x:Static common:AppIcons.Terminal}"
            Margin="0,0,0,12">
            <controls:PageHeader.Badge>
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusCountText}" FontSize="10" FontFamily="Consolas, monospace" Foreground="{DynamicResource MutedForegroundColor}"/>
                </Border>
            </controls:PageHeader.Badge>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- Level Filter Group (Segmented) -->
                <Border Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="2">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="Ghost"
                                Classes.Primary="{Binding FilterLevel, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=ALL}"
                                Command="{Binding SetFilterCommand}" CommandParameter="ALL" Content="ALL" Height="24" FontSize="10" Padding="8,0" CornerRadius="4"/>
                        <Button Classes="Ghost"
                                Classes.Primary="{Binding FilterLevel, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=INFO}"
                                Command="{Binding SetFilterCommand}" CommandParameter="INFO" Content="INFO" Height="24" FontSize="10" Padding="8,0" CornerRadius="4"/>
                        <Button Classes="Ghost"
                                Classes.Primary="{Binding FilterLevel, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=WARN}"
                                Command="{Binding SetFilterCommand}" CommandParameter="WARN" Content="WARN" Height="24" FontSize="10" Padding="8,0" CornerRadius="4"/>
                        <Button Classes="Ghost"
                                Classes.Primary="{Binding FilterLevel, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=ERROR}"
                                Command="{Binding SetFilterCommand}" CommandParameter="ERROR" Content="ERROR" Height="24" FontSize="10" Padding="8,0" CornerRadius="4"/>
                    </StackPanel>
                </Border>

                <!-- Search Input -->
                <TextBox
                    Text="{Binding SearchQuery, Mode=TwoWay}"
                    PlaceholderText="{Binding [client_logs_filter], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Width="130"
                    Height="26"
                    FontSize="11" />

                <!-- Auto-Scroll Button -->
                <Button Classes="Outline"
                        Command="{Binding ToggleAutoScrollCommand}"
                        Content="{Binding ScrollButtonText}"
                        Height="26"
                        FontSize="11"
                        Padding="8,0"/>

                <!-- Clear Logs Button -->
                <Button Classes="Outline"
                        Command="{Binding ClearLogsCommand}"
                        Height="26"
                        FontSize="11"
                        Padding="8,0">
                    <TextBlock Text="{Binding [client_logs_clear], Source={x:Static i18n:LocalizationManager.Instance}}"
                               Foreground="#ef4444"/>
                </Button>

                <!-- Copy All Logs Button -->
                <Button Classes="Outline"
                        Command="{Binding CopyAllLogsCommand}"
                        Height="26"
                        FontSize="11"
                        Padding="8,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <common:LucideIcon IsVisible="{Binding !CopiedAll}" Data="{x:Static common:AppIcons.Copy}" Width="12" Height="12"/>
                        <common:LucideIcon IsVisible="{Binding CopiedAll}" Data="{x:Static common:AppIcons.Check}" Width="12" Height="12" Foreground="#10b981"/>
                        <TextBlock Text="{Binding CopyButtonText}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <!-- Terminal Viewport Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6"
                ClipToBounds="True">
            <Panel>
                <controls:EmptyState
                    IsVisible="{Binding IsEmpty}"
                    Icon="{x:Static common:AppIcons.Terminal}"
                    Title="{Binding [client_logs_empty], Source={x:Static i18n:LocalizationManager.Instance}}"/>

                <!-- Logs List Stream -->
                <ListBox
                    x:Name="LogsList"
                    IsVisible="{Binding HasLogs}"
                    ItemsSource="{Binding FilteredLogs}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#10888888"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#08888888"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="native:ClientLogEntry">
                            <Grid ColumnDefinitions="Auto, Auto, Auto, *" Margin="0,1">
                                <!-- Timestamp -->
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding Timestamp, Converter={x:Static common:Converters.TimestampToTimeStr}}"
                                    FontSize="11"
                                    FontFamily="Consolas, Cascadia Mono, monospace"
                                    Foreground="{DynamicResource MutedForegroundColor}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>

                                <!-- Level Badge -->
                                <Border
                                    Grid.Column="1"
                                    CornerRadius="3"
                                    Background="{Binding Level, Converter={x:Static common:Converters.LogLevelToBackgroundBrush}}"
                                    BorderBrush="{Binding Level, Converter={x:Static common:Converters.LogLevelToBrush}}"
                                    BorderThickness="1"
                                    Padding="4,0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Level}" FontSize="9" FontWeight="Bold"
                                               Foreground="{Binding Level, Converter={x:Static common:Converters.LogLevelToBrush}}"/>
                                </Border>

                                <!-- Target -->
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Target, StringFormat='{}{0}:'}"
                                    FontSize="11"
                                    FontFamily="Consolas, Cascadia Mono, monospace"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource MutedForegroundColor}"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"/>

                                <!-- Message -->
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding Message}"
                                    FontSize="11"
                                    FontFamily="Consolas, Cascadia Mono, monospace"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Floating Jump to Latest Button -->
                <Button
                    IsVisible="{Binding ShowScrollToBottom}"
                    Command="{Binding ScrollToBottomCommand}"
                    Classes="Primary"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"
                    CornerRadius="14"
                    Height="28"
                    Padding="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <common:LucideIcon Data="{x:Static common:AppIcons.ArrowDown}" Width="12" Height="12" Foreground="{DynamicResource PrimaryForegroundColor}"/>
                        <TextBlock Text="{Binding [client_logs_latest], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Panel>
        </Border>
    </Grid>
</UserControl>
