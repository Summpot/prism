<UserControl
    x:Class="Prism.Views.ClientMiddlewareView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:native="clr-namespace:Prism.Native"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
    x:DataType="vm:ClientMiddlewareViewModel">

    <Grid RowDefinitions="Auto, *" Margin="16">
        <controls:PageHeader
            Grid.Row="0"
            Title="{Binding [client_middleware_title], Source={x:Static i18n:LocalizationManager.Instance}}"
            Description="{Binding [client_middleware_description], Source={x:Static i18n:LocalizationManager.Instance}}"
            Icon="{x:Static common:AppIcons.Sliders}"
            Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="Outline" Command="{Binding ResetConfigCommand}" Height="28" Padding="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="12" Height="12"/>
                        <TextBlock Text="{Binding [middleware_reset_defaults], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11"/>
                    </StackPanel>
                </Button>
                <Button Classes="Primary" Command="{Binding SaveConfigCommand}" Height="28" Padding="12,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <common:LucideIcon Data="{x:Static common:AppIcons.Check}" Width="12" Height="12" Foreground="{DynamicResource PrimaryForegroundColor}"/>
                        <TextBlock Text="{Binding [middleware_apply], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <!-- 2-Column Content: Middlewares List + Config Form -->
        <Grid Grid.Row="1" ColumnDefinitions="280, 10, *">
            <!-- Left: Middlewares List -->
            <shadui:Card Grid.Column="0" Padding="12">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                        <TextBlock Text="{Binding [middleware_selector], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Middlewares.Count, StringFormat='{}{0}'}" FontSize="10" Foreground="{DynamicResource MutedForegroundColor}"/>
                        </Border>
                    </Grid>

                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding Middlewares}"
                        SelectedItem="{Binding SelectedMiddleware, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource GhostColor}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="native:MiddlewareItem">
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [middleware_badge], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundColor}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding EffectiveConfig.Count, StringFormat='{}{0}'}" FontSize="10" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </shadui:Card>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="10" Background="Transparent" ResizeDirection="Columns"/>

            <!-- Right: Dynamic Schema Form -->
            <shadui:Card Grid.Column="2" Padding="16">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <!-- Middleware Title & Toggle -->
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding SelectedMiddleware.Name}" FontWeight="Bold" FontSize="15"
                                               IsVisible="{Binding SelectedMiddleware, Converter={x:Static common:Converters.NotNullToBoolean}}"/>
                                    <TextBlock Text="{Binding [middleware_select_placeholder], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="Bold" FontSize="15"
                                               IsVisible="{Binding SelectedMiddleware, Converter={x:Static common:Converters.NullToTrue}}"/>
                                    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IsMiddlewareEnabled, Converter={x:Static common:Converters.ActiveStatusToLabel}}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding IsMiddlewareEnabled, Converter={x:Static common:Converters.ActiveStatusToBrush}}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding [middleware_description], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding IsMiddlewareEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="{DynamicResource BorderColor}" Height="1" Margin="0,2"/>

                        <!-- Empty state if no fields -->
                        <TextBlock
                            IsVisible="{Binding ConfigFields.Count, Converter={x:Static common:Converters.EqualsZero}}"
                            Text="{Binding [middleware_no_schema_generic], Source={x:Static i18n:LocalizationManager.Instance}}"
                            FontSize="12"
                            Foreground="{DynamicResource MutedForegroundColor}"/>

                        <!-- Polymorphic Fields ItemsControl with DataTemplates -->
                        <ItemsControl ItemsSource="{Binding ConfigFields}">
                            <ItemsControl.DataTemplates>
                                <!-- Boolean field template -->
                                <DataTemplate DataType="vm:BoolMiddlewareFieldViewModel">
                                    <Border Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Label}" FontWeight="Medium" FontSize="12"/>
                                                    <Border IsVisible="{Binding IsModified}" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource PrimaryColor}" BorderThickness="1" CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding [middleware_modified], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryColor}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    IsVisible="{Binding Description, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                                                    Text="{Binding Description}"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource MutedForegroundColor}"
                                                    TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding Value, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>

                                <!-- Numeric field template -->
                                <DataTemplate DataType="vm:NumberMiddlewareFieldViewModel">
                                    <StackPanel Spacing="4" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Label}" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                                            <Border IsVisible="{Binding IsModified}" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource PrimaryColor}" BorderThickness="1" CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding [middleware_modified], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryColor}"/>
                                            </Border>
                                        </StackPanel>
                                        <NumericUpDown Value="{Binding Value, Mode=TwoWay}" Height="32" FontSize="12" CornerRadius="6"/>
                                        <TextBlock
                                            IsVisible="{Binding Description, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                                            Text="{Binding Description}"
                                            FontSize="10"
                                            Foreground="{DynamicResource MutedForegroundColor}"
                                            TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DefaultValue, StringFormat='Default: {0}'}" FontSize="10" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- ListString field template -->
                                <DataTemplate DataType="vm:ListStringMiddlewareFieldViewModel">
                                    <StackPanel Spacing="4" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Label}" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                                            <Border IsVisible="{Binding IsModified}" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource PrimaryColor}" BorderThickness="1" CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding [middleware_modified], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryColor}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBox Text="{Binding Value, Mode=TwoWay}" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap" FontSize="12" CornerRadius="6"/>
                                        <TextBlock
                                            IsVisible="{Binding Description, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                                            Text="{Binding Description}"
                                            FontSize="10"
                                            Foreground="{DynamicResource MutedForegroundColor}"
                                            TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DefaultValue, StringFormat='Default: {0}'}" FontSize="10" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- String field template -->
                                <DataTemplate DataType="vm:StringMiddlewareFieldViewModel">
                                    <StackPanel Spacing="4" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Label}" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                                            <Border IsVisible="{Binding IsModified}" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource PrimaryColor}" BorderThickness="1" CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding [middleware_modified], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource PrimaryColor}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBox Text="{Binding Value, Mode=TwoWay}" Height="32" FontSize="12" CornerRadius="6"/>
                                        <TextBlock
                                            IsVisible="{Binding Description, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                                            Text="{Binding Description}"
                                            FontSize="10"
                                            Foreground="{DynamicResource MutedForegroundColor}"
                                            TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DefaultValue, StringFormat='Default: {0}'}" FontSize="10" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource MutedForegroundColor}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>

                        <!-- Status Message -->
                        <TextBlock
                            IsVisible="{Binding StatusMessage, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                            Text="{Binding StatusMessage}"
                            FontSize="11"
                            Foreground="{DynamicResource PrimaryColor}"
                            Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </shadui:Card>
        </Grid>
    </Grid>
</UserControl>
