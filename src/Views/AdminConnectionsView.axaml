<UserControl
    x:Class="Prism.Views.AdminConnectionsView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
    x:DataType="vm:AdminConnectionsViewModel">

    <Panel>
    <controls:AdminReady State="{Binding ReadyState}" ConnectCommand="{Binding GoToConnectCommand}"
                         IsVisible="{Binding IsReady, Converter={x:Static common:Converters.BooleanNegation}}"/>
    <Grid RowDefinitions="Auto, Auto, *" Margin="16" IsVisible="{Binding IsReady}">
        <controls:PageHeader
            Grid.Row="0"
            Title="{Binding [nav_connections], Source={x:Static i18n:LocalizationManager.Instance}}"
            Description="{Binding [admin_connections_subtitle], Source={x:Static i18n:LocalizationManager.Instance}}"
            Icon="{x:Static common:AppIcons.Cable}"
            Margin="0,0,0,16">
            <controls:PageHeader.Badge>
                <shadui:Badge Content="{Binding Connections.Count}" Height="20" Padding="6,0" FontSize="10" VerticalAlignment="Center"/>
            </controls:PageHeader.Badge>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox
                    Text="{Binding SearchQuery, Mode=TwoWay}"
                    PlaceholderText="{Binding [admin_filter_connections], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Width="180"
                    Height="28"
                    FontSize="11"/>
                <Button Classes="Outline" Command="{Binding ToggleAutoRefreshCommand}" Height="28" Padding="10,0">
                    <TextBlock Text="{Binding AutoRefreshText}" FontSize="11"/>
                </Button>
                <Button Classes="Outline" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={x:Static common:Converters.BooleanNegation}}"
                        Height="28" Padding="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="12" Height="12"/>
                        <TextBlock Text="{Binding [common_refresh], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <controls:ErrorBanner
            Grid.Row="1"
            Message="{Binding ErrorMessage}"
            RetryCommand="{Binding RefreshCommand}"
            Margin="0,0,0,12"/>

        <!-- Connections Table -->
        <shadui:Card Grid.Row="2" Padding="12">
            <Grid>
                <DataGrid
                    ItemsSource="{Binding Connections}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding [admin_col_session_id], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Id}" MinWidth="90" Width="100"/>
                        <DataGridTextColumn Header="{Binding [admin_col_client_id], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Client}" MinWidth="110" Width="*"/>
                        <DataGridTextColumn Header="{Binding [admin_host], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Host}" MinWidth="100" Width="*"/>
                        <DataGridTextColumn Header="{Binding [admin_col_remote_target], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Upstream}" MinWidth="110" Width="1.2*"/>
                        <DataGridTextColumn Header="{Binding [admin_col_duration], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Duration}" MinWidth="70" Width="80"/>
                        <DataGridTextColumn Header="{Binding [admin_col_raw_traffic], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding RawBytes}" MinWidth="85" Width="95"/>
                        <DataGridTextColumn Header="{Binding [admin_col_wire_traffic], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding WireBytes}" MinWidth="85" Width="95"/>
                        <DataGridTextColumn Header="{Binding [admin_col_optimizer], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding OptimizerText}" MinWidth="75" Width="80"/>
                        <DataGridTemplateColumn Header="{Binding [admin_col_action], Source={x:Static i18n:LocalizationManager.Instance}}" MinWidth="80" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ConnectionItem">
                                    <Button
                                        Classes="Outline"
                                        Command="{Binding #Root.((vm:AdminConnectionsViewModel)DataContext).DisconnectCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding [admin_close], Source={x:Static i18n:LocalizationManager.Instance}}"
                                        Height="24"
                                        FontSize="10"
                                        Padding="6,0"
                                        Foreground="{DynamicResource DestructiveColor}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:EmptyState
                    IsVisible="{Binding Connections.Count, Converter={x:Static common:Converters.EqualsZero}}"
                    Icon="{x:Static common:AppIcons.Radio}"
                    Title="{Binding [admin_no_active_connections], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Margin="0,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>
        </shadui:Card>
    </Grid>
    </Panel>
</UserControl>
