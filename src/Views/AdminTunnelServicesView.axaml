<UserControl
    x:Class="Prism.Views.AdminTunnelServicesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
    x:DataType="vm:AdminTunnelServicesViewModel">

    <Panel>
    <controls:AdminReady State="{Binding ReadyState}" ConnectCommand="{Binding GoToConnectCommand}"
                         IsVisible="{Binding IsReady, Converter={x:Static common:Converters.BooleanNegation}}"/>
    <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="{DynamicResource PageMargin}" IsVisible="{Binding IsReady}">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <common:LucideIcon Data="{x:Static common:AppIcons.Server}" Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding [nav_services], Source={x:Static i18n:LocalizationManager.Instance}}" Classes="h2" VerticalAlignment="Center"/>
                <shadui:Badge Content="{Binding Services.Count}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="Outline" Command="{Binding ToggleAutoRefreshCommand}">
                    <TextBlock Text="{Binding AutoRefreshText}"/>
                </Button>
                <Button Classes="Outline" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={x:Static common:Converters.BooleanNegation}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="16" Height="16"/>
                        <TextBlock Text="{Binding [common_refresh], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <controls:ErrorBanner
            Grid.Row="1"
            Message="{Binding ErrorMessage}"
            RetryCommand="{Binding RefreshCommand}"
            Margin="0,0,0,16"/>

        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
            <TextBox
                Grid.Column="0"
                Text="{Binding SearchQuery, Mode=TwoWay}"
                PlaceholderText="{Binding [admin_services_filter], Source={x:Static i18n:LocalizationManager.Instance}}"
                Margin="0,0,8,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleSwitch IsChecked="{Binding PrimaryOnly, Mode=TwoWay}" OnContent="" OffContent=""/>
                <TextBlock Text="{Binding [services_primary_only], Source={x:Static i18n:LocalizationManager.Instance}}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Services Table -->
        <Grid Grid.Row="3">
                <DataGrid
                    ItemsSource="{Binding Services}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding [admin_col_service_name], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Name}" MinWidth="110" Width="1.2*"/>
                        <DataGridTextColumn Header="{Binding [admin_col_protocol], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Proto}" MinWidth="60" Width="70"/>
                        <DataGridTextColumn Header="{Binding [admin_col_client_id], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding ClientDisplay}" MinWidth="90" Width="*"/>
                        <DataGridTextColumn Header="{Binding [admin_col_remote_addr], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Remote}" MinWidth="100" Width="*"/>
                        <DataGridTextColumn Header="{Binding [admin_col_role], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding RoleText}" MinWidth="70" Width="80"/>
                        <DataGridTextColumn Header="{Binding [admin_col_route], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding RouteText}" MinWidth="70" Width="80"/>
                        <DataGridTextColumn Header="{Binding [admin_col_local_addr], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding LocalAddr}" MinWidth="100" Width="*"/>
                        <DataGridTextColumn Header="{Binding [admin_col_remote_target], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding RemoteAddr}" MinWidth="110" Width="1.1*"/>
                        <DataGridTextColumn Header="{Binding [admin_col_masquerade_sni], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Masquerade}" MinWidth="90" Width="*"/>
                        <DataGridTemplateColumn Header="{Binding [admin_col_status], Source={x:Static i18n:LocalizationManager.Instance}}" MinWidth="80" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ServiceRowItem">
                                    <shadui:Badge Classes="Outline"
                                                 Content="{Binding IsActive, Converter={x:Static common:Converters.ActiveStatusToLabel}}"
                                                 Foreground="{Binding IsActive, Converter={x:Static common:Converters.ActiveStatusToBrush}}"
                                                 HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:EmptyState
                    IsVisible="{Binding Services.Count, Converter={x:Static common:Converters.EqualsZero}}"
                    Icon="{x:Static common:AppIcons.Server}"
                    Title="{Binding [admin_no_services_found], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Margin="0,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
        </Grid>
    </Grid>
    </Panel>
</UserControl>
