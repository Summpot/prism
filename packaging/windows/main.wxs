<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*"
             Name="Prism"
             Language="1033"
             Version="$(var.Version)"
             Manufacturer="Prism"
             UpgradeCode="8B5034D1-0C7A-4545-983D-CEF15456A8F2">
        <Package InstallerVersion="200"
                 Compressed="yes"
                 InstallScope="perUser"
                 InstallPrivileges="limited"
                 Description="Prism Installer"
                 Comments="Prism Client" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of Prism is already installed." AllowSameVersionUpgrades="yes" />
        <MediaTemplate EmbedCab="yes" />

        <Icon Id="PrismIcon" SourceFile="$(var.IconPath)" />
        <Property Id="ARPPRODUCTICON" Value="PrismIcon" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="LocalAppDataFolder">
                <Directory Id="ProgramsFolder" Name="Programs">
                    <Directory Id="INSTALLFOLDER" Name="Prism" />
                </Directory>
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="Prism" />
            </Directory>
            <Directory Id="DesktopFolder" Name="Desktop" />
        </Directory>

        <DirectoryRef Id="INSTALLFOLDER">
            <Component Id="PrismExecutable" Guid="9F2D7B41-4567-4289-A512-3B4C5D6E7F80">
                <File Id="PrismEXE" Source="$(var.BinPath)" KeyPath="yes">
                    <Shortcut Id="ApplicationDesktopShortcut"
                              Directory="DesktopFolder"
                              Name="Prism"
                              WorkingDirectory="INSTALLFOLDER"
                              Icon="PrismIcon"
                              Advertise="yes" />
                    <Shortcut Id="ApplicationStartMenuShortcut"
                              Directory="ApplicationProgramsFolder"
                              Name="Prism"
                              WorkingDirectory="INSTALLFOLDER"
                              Icon="PrismIcon"
                              Advertise="yes" />
                </File>
                <!-- Register prism:// protocol -->
                <RegistryKey Root="HKCU" Key="Software\Classes\prism">
                    <RegistryValue Type="string" Value="URL:Prism Protocol" />
                    <RegistryValue Type="string" Name="URL Protocol" Value="" />
                    <RegistryValue Root="HKCU" Key="Software\Classes\prism\DefaultIcon" Type="string" Value="[INSTALLFOLDER]prism.exe,0" />
                    <RegistryValue Root="HKCU" Key="Software\Classes\prism\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]prism.exe&quot; &quot;%1&quot;" />
                </RegistryKey>
                <RegistryValue Root="HKCU" Key="Software\Prism" Name="installed" Type="integer" Value="1" />
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="E3A7C125-9B84-4861-8201-9F3E8A1D2B4C">
                <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\Prism" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <Feature Id="ProductFeature" Title="Prism" Level="1">
            <ComponentRef Id="PrismExecutable" />
            <ComponentRef Id="ApplicationShortcut" />
        </Feature>

        <UIRef Id="WixUI_Minimal" />
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    </Product>
</Wix>
