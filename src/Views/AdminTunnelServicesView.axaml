<UserControl
    x:Class="Prism.Views.AdminTunnelServicesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
    x:DataType="vm:AdminTunnelServicesViewModel">

    <Grid RowDefinitions="Auto, Auto, *" Margin="20">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding [nav_services], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="Bold" FontSize="20"/>
                    <shadui:Badge Content="{Binding Services.Count}" Height="20" Padding="6,0" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding [admin_services_subtitle], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="Outline" Command="{Binding ToggleAutoRefreshCommand}" Height="28" Padding="10,0">
                    <TextBlock Text="{Binding AutoRefreshText}" FontSize="11"/>
                </Button>
                <Button Classes="Outline" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={x:Static common:Converters.BooleanNegation}}"
                        Height="28" Padding="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="12" Height="12"/>
                        <TextBlock Text="{Binding [common_refresh], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Error Banner -->
        <Border
            Grid.Row="1"
            IsVisible="{Binding ErrorMessage, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
            Background="#20ef4444"
            BorderBrush="#50ef4444"
            BorderThickness="1"
            CornerRadius="{DynamicResource MdCornerRadius}"
            Padding="12,8"
            Margin="0,0,0,12">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#ef4444" FontSize="12"/>
        </Border>

        <!-- Services Table -->
        <shadui:Card Grid.Row="2" Padding="12">
            <Grid>
                <DataGrid
                    ItemsSource="{Binding Services}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding [admin_col_service_name], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="{Binding [admin_col_protocol], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Proto}" Width="90"/>
                        <DataGridTextColumn Header="{Binding [admin_col_local_addr], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding LocalAddr}" Width="*"/>
                        <DataGridTextColumn Header="{Binding [admin_col_remote_target], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding RemoteAddr}" Width="*"/>
                        <DataGridTextColumn Header="{Binding [admin_col_masquerade_sni], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding Masquerade}" Width="*"/>
                        <DataGridTemplateColumn Header="{Binding [admin_col_status], Source={x:Static i18n:LocalizationManager.Instance}}" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ServiceRowItem">
                                    <shadui:Badge Content="ACTIVE" Background="#10b981" Foreground="White" Height="18" Padding="6,0" FontSize="10" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State -->
                <StackPanel
                    IsVisible="{Binding Services.Count, Converter={x:Static common:Converters.EqualsZero}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Margin="0,40">
                    <common:LucideIcon Data="{x:Static common:AppIcons.Server}" Width="28" Height="28" Foreground="{DynamicResource MutedForegroundColor}"/>
                    <TextBlock Text="{Binding [admin_no_services_found], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="12" Foreground="{DynamicResource MutedForegroundColor}"/>
                </StackPanel>
            </Grid>
        </shadui:Card>
    </Grid>
</UserControl>
