<UserControl
    x:Class="Prism.Views.ClientOverviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    x:DataType="vm:ClientOverviewViewModel"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{DynamicResource PageMaxWidth}" Spacing="16" Margin="{DynamicResource PageMargin}">

            <controls:ErrorBanner
                Message="{Binding ErrorMessage}"
                DismissCommand="{Binding DismissErrorCommand}"/>

            <shadui:Card IsVisible="{Binding ShowLoggedInCard}">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                    <shadui:Avatar
                        Grid.Column="0"
                        Source="{Binding UserAvatarBitmap}"
                        Fallback="{Binding SessionUsername, Converter={x:Static common:Converters.AvatarInitials}}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding SessionUsername}" Classes="Large" VerticalAlignment="Center"/>
                            <shadui:Badge
                                Content="{Binding [client_admin], Source={x:Static i18n:LocalizationManager.Instance}}"
                                IsVisible="{Binding SessionIsAdmin}"
                                Classes="Secondary"
                                VerticalAlignment="Center"/>
                            <shadui:Badge
                                Content="{Binding [client_member], Source={x:Static i18n:LocalizationManager.Instance}}"
                                IsVisible="{Binding !SessionIsAdmin}"
                                Classes="Secondary"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                Text="{Binding ServerAddress}"
                                Classes="Caption Muted"
                                FontFamily="{DynamicResource MonoFont}"
                                VerticalAlignment="Center"/>
                            <Button Classes="Ghost" Command="{Binding CopyServerAddressCommand}"
                                    Width="32" Height="32" Padding="0"
                                    ToolTip.Tip="{Binding [common_copy], Source={x:Static i18n:LocalizationManager.Instance}}"
                                    VerticalAlignment="Center">
                                <common:LucideIcon Data="{x:Static common:AppIcons.Copy}" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Classes="Outline"
                        VerticalAlignment="Center"
                        Command="{Binding SignOutCommand}"
                        Content="{Binding [client_sign_out], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                </Grid>
            </shadui:Card>

            <shadui:Card IsVisible="{Binding ShowConnectAndLoginHero}">
                <shadui:Card.Header>
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <shadui:CardTitle Grid.Column="0" Content="{Binding [client_connect_and_login], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                        <TextBlock
                            Grid.Column="1"
                            Classes="Caption Muted"
                            Text="{Binding [client_anonymous_hint], Source={x:Static i18n:LocalizationManager.Instance}}"
                            VerticalAlignment="Center"/>
                    </Grid>
                </shadui:Card.Header>
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                        <ComboBox
                            Grid.Column="0"
                            ItemsSource="{Binding SupportedProtocols}"
                            SelectedItem="{Binding SelectedProtocol}"
                            FontFamily="{DynamicResource MonoFont}"
                            MinWidth="120"
                            VerticalAlignment="Center"/>
                        <TextBox
                            Grid.Column="1"
                            Text="{Binding RemoteLinkInput, Mode=TwoWay}"
                            PlaceholderText="{Binding [client_remote_placeholder], Source={x:Static i18n:LocalizationManager.Instance}}"
                            FontFamily="{DynamicResource MonoFont}"
                            VerticalAlignment="Center">
                            <TextBox.InnerRightContent>
                                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                    <Button Classes="Ghost" Command="{Binding PasteToRemoteLinkInputCommand}"
                                            Width="32" Height="32" Padding="0"
                                            ToolTip.Tip="{Binding [common_paste], Source={x:Static i18n:LocalizationManager.Instance}}">
                                        <common:LucideIcon Data="{x:Static common:AppIcons.Download}" Width="16" Height="16"/>
                                    </Button>
                                    <Button Classes="Ghost" Command="{Binding CopyConnectionCommand}"
                                            Width="32" Height="32" Padding="0"
                                            ToolTip.Tip="{Binding [client_copy_connection], Source={x:Static i18n:LocalizationManager.Instance}}">
                                        <common:LucideIcon Data="{x:Static common:AppIcons.Copy}" Width="16" Height="16"/>
                                    </Button>
                                    <Button Classes="Ghost" Command="{Binding ClearRemoteLinkInputCommand}"
                                            Width="32" Height="32" Padding="0"
                                            ToolTip.Tip="{Binding [client_clear], Source={x:Static i18n:LocalizationManager.Instance}}">
                                        <common:LucideIcon Data="{x:Static common:AppIcons.Close}" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <Button
                            Grid.Column="2"
                            Classes="Primary"
                            Command="{Binding ConnectFromLinkCommand}"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <common:LucideIcon Data="{x:Static common:AppIcons.Power}" Width="16" Height="16"/>
                                <TextBlock Text="{Binding TunnelButtonText}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel IsVisible="{Binding ShowLoginMethods}" Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock
                                Grid.Column="0"
                                FontWeight="SemiBold"
                                Text="{Binding [client_login_methods_detected], Source={x:Static i18n:LocalizationManager.Instance}}"
                                VerticalAlignment="Center"/>
                            <shadui:Badge
                                Grid.Column="1"
                                Classes="Outline"
                                Content="{Binding [client_waiting_for_login], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                        </Grid>

                        <Button
                            Classes="Outline"
                            Command="{Binding StartGitHubLoginCommand}"
                            IsVisible="{Binding IsGithubAuthAvailable}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border
                                    Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="{DynamicResource MdCornerRadius}"
                                    Background="{DynamicResource PrimaryColor}"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                    <common:LucideIcon Data="{x:Static common:AppIcons.Github}" Width="16" Height="16" Foreground="{DynamicResource PrimaryForegroundColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding [client_github_login], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold"/>
                                        <shadui:Badge Classes="Secondary" Content="{Binding [client_recommended], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                                    </StackPanel>
                                    <TextBlock Classes="Caption Muted" Text="{Binding [client_identity_hint], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            Classes="Ghost"
                            Command="{Binding DismissLoginMethodsCommand}"
                            HorizontalAlignment="Center"
                            Content="{Binding [client_anonymous], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                    </StackPanel>

                    <Border
                        IsVisible="{Binding ShowOAuthWaiting}"
                        Background="{DynamicResource GhostColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource MdCornerRadius}"
                        Padding="16">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <shadui:Loading Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}"/>
                                    <TextBlock Text="{Binding [client_wait_github], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="Ghost" Command="{Binding CancelOAuthCommand}"
                                        Content="{Binding [common_cancel], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                            </Grid>
                            <TextBlock Classes="Caption Muted" TextWrapping="Wrap"
                                       Text="{Binding [client_github_browser_hint], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding ManualCallbackInput, Mode=TwoWay}"
                                         PlaceholderText="{Binding [client_callback_placeholder], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                                <Button Grid.Column="1" Classes="Primary" Command="{Binding VerifyManualCallbackCommand}"
                                        Content="{Binding [client_verify], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        IsVisible="{Binding ShowOAuthExchanging}"
                        Background="{DynamicResource GhostColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource MdCornerRadius}"
                        Padding="16">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <shadui:Loading Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}"/>
                            <TextBlock Text="{Binding [client_exchange_github], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </shadui:Card>

            <shadui:Card>
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <Border
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            CornerRadius="{DynamicResource LgCornerRadius}"
                            Background="{DynamicResource GhostColor}">
                            <common:LucideIcon
                                Data="{x:Static common:AppIcons.Radio}"
                                Width="16"
                                Height="16"
                                Foreground="{Binding IsConnected, Converter={x:Static common:Converters.StatusToBrush}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding ProfileName}" Classes="Large" VerticalAlignment="Center"/>
                                <shadui:Badge Classes="Secondary" Content="{Binding ActiveTransport}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock
                                Text="{Binding MappingText}"
                                Classes="Caption Muted"
                                FontFamily="{DynamicResource MonoFont}"/>
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            IsVisible="{Binding IsRunning}"
                            Classes="Outline"
                            VerticalAlignment="Center"
                            BorderBrush="{DynamicResource DestructiveColor}"
                            Foreground="{DynamicResource DestructiveColor}"
                            Command="{Binding ToggleTunnelCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <common:LucideIcon Data="{x:Static common:AppIcons.Power}" Width="16" Height="16"/>
                                <TextBlock Text="{Binding [client_disconnect_tunnel], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="2"
                            IsVisible="{Binding !IsRunning}"
                            Classes="Primary"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleTunnelCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <common:LucideIcon Data="{x:Static common:AppIcons.Power}" Width="16" Height="16"/>
                                <TextBlock Text="{Binding [client_start_connection], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel IsVisible="{Binding IsConnected}" Spacing="16">
                        <Separator/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock
                                Grid.Column="0"
                                Classes="Caption Muted"
                                Text="{Binding [client_active], Source={x:Static i18n:LocalizationManager.Instance}}"
                                VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <ToggleButton
                                    Classes="Segment"
                                    IsChecked="{Binding StatsViewMode, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=session, Mode=OneWay}"
                                    Command="{Binding SetStatsModeCommand}"
                                    CommandParameter="session"
                                    Content="{Binding [client_session], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                                <ToggleButton
                                    Classes="Segment"
                                    IsChecked="{Binding StatsViewMode, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=lifetime, Mode=OneWay}"
                                    Command="{Binding SetStatsModeCommand}"
                                    CommandParameter="lifetime"
                                    Content="{Binding [client_lifetime], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="Caption Muted" Text="{Binding [client_uptime], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                                <TextBlock Classes="Large" FontFamily="{DynamicResource MonoFont}" Text="{Binding UptimeText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="Caption Muted" Text="{Binding [client_raw], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                                <TextBlock Classes="Large" FontFamily="{DynamicResource MonoFont}" Text="{Binding RawBytesText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="Caption Muted" Text="{Binding [client_wire], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                                <TextBlock Classes="Large" FontFamily="{DynamicResource MonoFont}" Text="{Binding WireBytesText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="4">
                                <TextBlock Classes="Caption" Foreground="{DynamicResource SuccessColor}" Text="{Binding [client_saved], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                                <TextBlock Classes="Large" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SuccessColor}" Text="{Binding SavedRatioText}"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                            <Grid ColumnDefinitions="Auto, *">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="↑" Foreground="{DynamicResource PrimaryColor}"/>
                                    <TextBlock Classes="Caption Muted" Text="{Binding [traffic_uplink], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding UplinkStatsText}" HorizontalAlignment="Right" FontFamily="{DynamicResource MonoFont}"/>
                            </Grid>
                            <Grid Grid.Column="1" ColumnDefinitions="Auto, *">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="↓" Foreground="{DynamicResource PrimaryColor}"/>
                                    <TextBlock Classes="Caption Muted" Text="{Binding [traffic_downlink], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DownlinkStatsText}" HorizontalAlignment="Right" FontFamily="{DynamicResource MonoFont}"/>
                            </Grid>
                        </Grid>

                        <Grid ColumnDefinitions="Auto, *">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <common:LucideIcon Data="{x:Static common:AppIcons.Activity}" Width="16" Height="16" Foreground="{DynamicResource SuccessColor}"/>
                                <TextBlock Text="{Binding ThroughputText}" Foreground="{DynamicResource SuccessColor}" FontFamily="{DynamicResource MonoFont}"/>
                            </StackPanel>
                            <common:SparklineControl
                                Grid.Column="1"
                                Samples="{Binding ThroughputSamples}"
                                Stroke="{DynamicResource StatusSuccessBrush}"
                                Fill="{DynamicResource StatusSuccessFillBrush}"
                                Height="32"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasCumulativeHistory}" Spacing="12">
                        <Separator/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Classes="Caption Muted" Text="{Binding CumulativeHistoryText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Classes="Ghost" Command="{Binding ResetStatsCommand}"
                                    Content="{Binding [client_reset], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </shadui:Card>

            <shadui:Card>
                <shadui:Card.Header>
                    <Grid ColumnDefinitions="*, Auto">
                        <shadui:CardTitle Grid.Column="0" VerticalAlignment="Center"
                                          Content="{Binding [client_discovered_services], Source={x:Static i18n:LocalizationManager.Instance}}"/>
                        <shadui:Badge Grid.Column="1" Classes="Outline" Content="{Binding DiscoveredServicesBadgeText}"/>
                    </Grid>
                </shadui:Card.Header>
                <StackPanel Spacing="8">
                    <ItemsControl ItemsSource="{Binding DiscoveredServices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiscoveredServiceItem">
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" Margin="0,8">
                                    <Border
                                        Width="32"
                                        Height="32"
                                        CornerRadius="{DynamicResource MdCornerRadius}"
                                        Background="{DynamicResource GhostColor}">
                                        <common:LucideIcon Data="{x:Static common:AppIcons.Radio}" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <shadui:Badge Classes="Secondary" Content="{Binding Proto}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding TargetAddress}" Classes="Caption" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource PrimaryColor}"/>
                                            <TextBlock Text="{Binding MasqueradeHost, StringFormat='({0})'}"
                                                       IsVisible="{Binding MasqueradeHost, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                                                       Classes="Caption Muted" FontFamily="{DynamicResource MonoFont}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        Classes="Outline"
                                        VerticalAlignment="Center"
                                        Command="{Binding $parent[UserControl].((vm:ClientOverviewViewModel)DataContext).CopyTargetCommand}"
                                        CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <common:LucideIcon Data="{Binding IsCopied, Converter={x:Static common:Converters.BoolToCopyOrCheckIcon}}"
                                                               Foreground="{Binding IsCopied, Converter={x:Static common:Converters.BoolToCopyOrCheckBrush}}"
                                                               Width="16" Height="16"/>
                                            <TextBlock Text="{Binding IsCopied, Converter={x:Static common:Converters.CopiedOrCopyLabel}}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Spacing="4" IsVisible="{Binding DiscoveredServices.Count, Converter={x:Static common:Converters.EqualsZero}}">
                        <TextBlock
                            Classes="Caption Muted"
                            Text="{Binding DiscoveredServicesEmptyTitle}"
                            TextWrapping="Wrap"/>
                        <TextBlock
                            IsVisible="{Binding DiscoveredServicesEmptyHint, Converter={x:Static common:Converters.NullOrEmptyToBoolean}}"
                            Classes="Caption Muted"
                            Text="{Binding DiscoveredServicesEmptyHint}"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </shadui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
