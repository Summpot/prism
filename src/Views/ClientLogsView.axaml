<UserControl
    x:Class="Prism.Views.ClientLogsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:native="clr-namespace:Prism.Native"
    x:DataType="vm:ClientLogsViewModel"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto, *" Margin="16">
        <!-- Header Controls Row -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <common:LucideIcon Data="{x:Static common:AppIcons.Terminal}" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}"/>
                <TextBlock Text="{Binding [client_logs_title], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="Bold" FontSize="16"/>
                <shadui:Badge Content="{Binding StatusCountText}" Height="20" Padding="6,0" FontSize="10"/>
            </StackPanel>

            <!-- Filters -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <!-- Level Filter Group (Segmented) -->
                <Border Background="{DynamicResource GhostColor}" CornerRadius="6" Padding="2" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="Ghost"
                                Classes.Primary="{Binding FilterLevel, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=ALL}"
                                Command="{Binding SetFilterCommand}" CommandParameter="ALL" Content="ALL" Height="24" FontSize="10" Padding="8,0" CornerRadius="4"/>
                        <Button Classes="Ghost"
                                Classes.Primary="{Binding FilterLevel, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=INFO}"
                                Command="{Binding SetFilterCommand}" CommandParameter="INFO" Content="INFO" Height="24" FontSize="10" Padding="8,0" CornerRadius="4"/>
                        <Button Classes="Ghost"
                                Classes.Primary="{Binding FilterLevel, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=WARN}"
                                Command="{Binding SetFilterCommand}" CommandParameter="WARN" Content="WARN" Height="24" FontSize="10" Padding="8,0" CornerRadius="4"/>
                        <Button Classes="Ghost"
                                Classes.Primary="{Binding FilterLevel, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=ERROR}"
                                Command="{Binding SetFilterCommand}" CommandParameter="ERROR" Content="ERROR" Height="24" FontSize="10" Padding="8,0" CornerRadius="4"/>
                    </StackPanel>
                </Border>

                <!-- Search Input -->
                <TextBox
                    Text="{Binding SearchQuery, Mode=TwoWay}"
                    PlaceholderText="{Binding [client_logs_filter], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Width="140"
                    Height="26"
                    FontSize="11" />

                <!-- AutoScroll Toggle -->
                <CheckBox IsChecked="{Binding AutoScroll, Mode=TwoWay}" Content="{Binding [client_logs_auto_scroll], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11" Margin="4,0"/>

                <!-- Clear Logs -->
                <Button Classes="Outline" Command="{Binding ClearLogsCommand}" Content="{Binding [client_logs_clear], Source={x:Static i18n:LocalizationManager.Instance}}" Height="26" FontSize="11" Padding="8,0"/>

                <!-- Copy All Logs -->
                <Button Classes="Outline" Command="{Binding CopyAllLogsCommand}" Content="{Binding [client_logs_copy_all], Source={x:Static i18n:LocalizationManager.Instance}}" Height="26" FontSize="11" Padding="8,0"/>
            </StackPanel>
        </Grid>

        <!-- Terminal Log Window -->
        <shadui:Card Grid.Row="1" Padding="4">
            <ListBox
                x:Name="LogsList"
                ItemsSource="{Binding FilteredLogs}"
                Background="Transparent"
                BorderThickness="0"
                Padding="4">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="native:ClientLogEntry">
                        <Grid ColumnDefinitions="Auto, Auto, Auto, *" Margin="0,2">
                            <!-- Timestamp -->
                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding Timestamp}"
                                FontSize="11"
                                FontFamily="Consolas, Courier New, monospace"
                                Foreground="{DynamicResource MutedForegroundColor}"
                                Margin="0,0,8,0" />

                            <!-- Level Badge -->
                            <Border
                                Grid.Column="1"
                                CornerRadius="3"
                                Background="{Binding Level, Converter={x:Static common:Converters.LogLevelToBrush}}"
                                Padding="4,1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                                <TextBlock Text="{Binding Level}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>

                            <!-- Target -->
                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding Target}"
                                FontSize="11"
                                FontFamily="Consolas, Courier New, monospace"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource MutedForegroundColor}"
                                Margin="0,0,6,0" />

                            <!-- Message -->
                            <TextBlock
                                Grid.Column="3"
                                Text="{Binding Message}"
                                FontSize="11"
                                FontFamily="Consolas, Courier New, monospace"
                                TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </shadui:Card>
    </Grid>
</UserControl>
