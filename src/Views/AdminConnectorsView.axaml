<UserControl
    x:Class="Prism.Views.AdminConnectorsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:services="clr-namespace:Prism.Services"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
    x:DataType="vm:AdminConnectorsViewModel">

    <Panel>
    <controls:AdminReady State="{Binding ReadyState}" ConnectCommand="{Binding GoToConnectCommand}"
                         IsVisible="{Binding IsReady, Converter={x:Static common:Converters.BooleanNegation}}"/>
    <Grid RowDefinitions="Auto, Auto, *" Margin="16" IsVisible="{Binding IsReady}">
        <controls:PageHeader
            Grid.Row="0"
            Title="{Binding [nav_connector_traffic], Source={x:Static i18n:LocalizationManager.Instance}}"
            Description="{Binding [admin_connectors_subtitle], Source={x:Static i18n:LocalizationManager.Instance}}"
            Icon="{x:Static common:AppIcons.Plug}"
            Margin="0,0,0,16">
            <controls:PageHeader.Badge>
                <shadui:Badge Content="{Binding Connectors.Count}" Height="20" Padding="6,0" FontSize="10" VerticalAlignment="Center"/>
            </controls:PageHeader.Badge>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox
                    Text="{Binding SearchQuery, Mode=TwoWay}"
                    PlaceholderText="{Binding [admin_connectors_filter], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Width="180"
                    Height="28"
                    FontSize="11"/>
                <Button Classes="Outline" Command="{Binding ToggleAutoRefreshCommand}" Height="28" Padding="10,0">
                    <TextBlock Text="{Binding AutoRefreshText}" FontSize="11"/>
                </Button>
                <Button Classes="Outline" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={x:Static common:Converters.BooleanNegation}}"
                        Height="28" Padding="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="12" Height="12"/>
                        <TextBlock Text="{Binding [common_refresh], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <controls:ErrorBanner
            Grid.Row="1"
            Message="{Binding ErrorMessage}"
            RetryCommand="{Binding RefreshCommand}"
            Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
        <!-- Connectors List -->
        <shadui:Card Padding="12">
            <Grid>
                <DataGrid
                    ItemsSource="{Binding Connectors}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding [admin_col_client_id], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding ClientId}" Width="160"/>
                        <DataGridTextColumn Header="{Binding [admin_col_remote_addr], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding RemoteAddr}" Width="*"/>
                        <DataGridTemplateColumn Header="{Binding [admin_col_role], Source={x:Static i18n:LocalizationManager.Instance}}" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ConnectorGroupItem">
                                    <shadui:Badge
                                        Content="{Binding Primary, Converter={x:Static common:Converters.PrimaryStandbyLabel}}"
                                        Height="20"
                                        Padding="6,0"
                                        FontSize="10"
                                        VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{Binding [admin_col_services], Source={x:Static i18n:LocalizationManager.Instance}}" Binding="{Binding ServiceCount}" Width="80"/>
                        <DataGridTemplateColumn Header="{Binding [admin_col_published_services], Source={x:Static i18n:LocalizationManager.Instance}}" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:ConnectorGroupItem">
                                    <ItemsControl ItemsSource="{Binding Services}" Margin="0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="services:AdminRegisteredService">
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"/>
                                                    <TextBlock Text="{Binding Proto, StringFormat='({0})'}" FontSize="10" Foreground="{DynamicResource MutedForegroundColor}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:EmptyState
                    IsVisible="{Binding Connectors.Count, Converter={x:Static common:Converters.EqualsZero}}"
                    Icon="{x:Static common:AppIcons.Radio}"
                    Title="{Binding [admin_no_active_connectors], Source={x:Static i18n:LocalizationManager.Instance}}"
                    Margin="0,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>
        </shadui:Card>

        <shadui:Card Padding="12" IsVisible="{Binding Unattached.Count, Converter={x:Static common:Converters.NotEqualsZero}}">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding [admin_connectors_unattached], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="13"/>
                <ItemsControl ItemsSource="{Binding Unattached}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServiceRowItem">
                            <Grid ColumnDefinitions="160, 70, *, Auto, Auto" Margin="0,3">
                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Proto}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Remote}" FontSize="11" FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding RoleText}" FontSize="11" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="4" Text="{Binding RouteText}" FontSize="11" Foreground="{DynamicResource MutedForegroundColor}" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </shadui:Card>
        </StackPanel>
        </ScrollViewer>
    </Grid>
    </Panel>
</UserControl>
