<UserControl
    x:Class="Prism.Views.ClientTrafficView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:i18n="clr-namespace:Prism.I18n"
    xmlns:vm="clr-namespace:Prism.ViewModels"
    xmlns:common="clr-namespace:Prism.Common"
    xmlns:controls="clr-namespace:Prism.Views.Controls"
    x:DataType="vm:ClientTrafficViewModel"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" Spacing="12" Margin="16">

            <controls:PageHeader
                Title="{Binding [client_traffic_title], Source={x:Static i18n:LocalizationManager.Instance}}"
                Description="{Binding [client_traffic_description], Source={x:Static i18n:LocalizationManager.Instance}}"
                Icon="{x:Static common:AppIcons.ArrowDownUp}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button
                                Classes="Ghost"
                                Classes.Primary="{Binding StatsViewMode, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=session}"
                                Command="{Binding SetStatsModeCommand}" CommandParameter="session"
                                Content="{Binding [client_session], Source={x:Static i18n:LocalizationManager.Instance}}"
                                Height="24" FontSize="11" Padding="8,0" CornerRadius="4"/>
                            <Button
                                Classes="Ghost"
                                Classes.Primary="{Binding StatsViewMode, Converter={x:Static common:Converters.RouteEquals}, ConverterParameter=lifetime}"
                                Command="{Binding SetStatsModeCommand}" CommandParameter="lifetime"
                                Content="{Binding [client_lifetime], Source={x:Static i18n:LocalizationManager.Instance}}"
                                Height="24" FontSize="11" Padding="8,0" CornerRadius="4"/>
                        </StackPanel>
                    </Border>
                    <Button Classes="Outline" Command="{Binding ResetStatsCommand}" Height="28" Padding="8,0" ToolTip.Tip="{Binding [client_reset_stats], Source={x:Static i18n:LocalizationManager.Instance}}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <common:LucideIcon Data="{x:Static common:AppIcons.RotateCcw}" Width="12" Height="12"/>
                            <TextBlock Text="{Binding [client_reset], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:PageHeader>

            <controls:EmptyState
                IsVisible="{Binding ShowEmptyState}"
                Icon="{x:Static common:AppIcons.WifiOff}"
                Title="{Binding [client_traffic_disconnected], Source={x:Static i18n:LocalizationManager.Instance}}"
                Description="{Binding [client_traffic_disconnected_hint], Source={x:Static i18n:LocalizationManager.Instance}}"/>

            <!-- Traffic Content Area -->
            <StackPanel IsVisible="{Binding HasTrafficData}" Spacing="12">

                <!-- 4 High-Level Metric Tiles -->
                <Grid ColumnDefinitions="*, *, *, *">
                    <shadui:Card Grid.Column="0" Margin="0,0,4,0" Padding="12">
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Metric1Title}" FontSize="10" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Metric1Value}" FontWeight="Bold" FontSize="14" FontFamily="{DynamicResource MonoFont}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </shadui:Card>
                    <shadui:Card Grid.Column="1" Margin="4,0,4,0" Padding="12">
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [client_raw], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="10" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RawBytesText}" FontWeight="Bold" FontSize="14" FontFamily="{DynamicResource MonoFont}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </shadui:Card>
                    <shadui:Card Grid.Column="2" Margin="4,0,4,0" Padding="12">
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [client_wire], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="10" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding WireBytesText}" FontWeight="Bold" FontSize="14" FontFamily="{DynamicResource MonoFont}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </shadui:Card>
                    <shadui:Card Grid.Column="3" Margin="4,0,0,0" Padding="12">
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [client_saved], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="10" Foreground="{DynamicResource SuccessColor}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SavedRatioText}" FontWeight="Bold" FontSize="14" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SuccessColor}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </shadui:Card>
                </Grid>

                <!-- Real-Time Throughput Graph (Connected only) -->
                <shadui:Card IsVisible="{Binding IsConnected}" Padding="12">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <common:LucideIcon Data="{x:Static common:AppIcons.Activity}" Width="13" Height="13" Foreground="{DynamicResource SuccessColor}"/>
                                <TextBlock Text="{Binding [traffic_throughput], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentThroughputText}" Foreground="{DynamicResource SuccessColor}" FontWeight="Bold" FontSize="12" FontFamily="{DynamicResource MonoFont}"/>
                        </Grid>
                        <common:SparklineControl
                            Height="64"
                            Samples="{Binding ThroughputSeries}"
                            Stroke="{DynamicResource SuccessColor}"
                            Fill="{DynamicResource SuccessTint}"
                            StrokeThickness="2"
                            Margin="0,6,0,2"/>
                    </StackPanel>
                </shadui:Card>

                <!-- Detailed Section Card (Session or Lifetime) -->
                <shadui:Card Padding="14">
                    <StackPanel Spacing="12">
                        <!-- Card Header -->
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="{Binding SectionTitle}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" IsVisible="{Binding HasTransport}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActualTransport}" FontSize="10" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource MutedForegroundColor}"/>
                            </Border>
                        </Grid>

                        <!-- Session Mode Details -->
                        <StackPanel IsVisible="{Binding IsSessionMode}" Spacing="10">
                            <!-- Row 1: 4 Stats -->
                            <Grid ColumnDefinitions="*, *, *, *">
                                <Border Grid.Column="0" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding [client_raw], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource MutedForegroundColor}"/>
                                        <TextBlock Text="{Binding SessionRawBytes}" FontWeight="SemiBold" FontSize="12" FontFamily="{DynamicResource MonoFont}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,4,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding [client_wire], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource MutedForegroundColor}"/>
                                        <TextBlock Text="{Binding SessionWireBytes}" FontWeight="SemiBold" FontSize="12" FontFamily="{DynamicResource MonoFont}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,4,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding [client_saved], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource SuccessColor}"/>
                                        <TextBlock Text="{Binding SessionSavedText}" FontWeight="SemiBold" FontSize="12" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SuccessColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding [traffic_link_rate], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource MutedForegroundColor}"/>
                                        <TextBlock Text="{Binding SessionLinkRate}" FontWeight="SemiBold" FontSize="12" FontFamily="{DynamicResource MonoFont}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 2: 3 Batch Stats -->
                            <Grid ColumnDefinitions="*, *, *">
                                <Border Grid.Column="0" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding [traffic_batches_urgent], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource MutedForegroundColor}"/>
                                        <TextBlock Text="{Binding UrgentBatchesText}" FontWeight="SemiBold" FontSize="12" FontFamily="{DynamicResource MonoFont}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,4,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding [traffic_batches_timer], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource MutedForegroundColor}"/>
                                        <TextBlock Text="{Binding TimerBatchesText}" FontWeight="SemiBold" FontSize="12" FontFamily="{DynamicResource MonoFont}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding [traffic_batches_threshold], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource MutedForegroundColor}"/>
                                        <TextBlock Text="{Binding ThresholdBatchesText}" FontWeight="SemiBold" FontSize="12" FontFamily="{DynamicResource MonoFont}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 3: Uplink & Downlink Direction Cards -->
                            <Grid ColumnDefinitions="*, *">
                                <!-- Uplink Direction Card -->
                                <Border Grid.Column="0" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,4,0">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="↑" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryColor}"/>
                                                <TextBlock Text="{Binding [traffic_uplink], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryColor}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding UplinkRawWireText}" FontSize="11" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="*, *">
                                            <Border Grid.Column="0" Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,3,0">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding [client_saved], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource SuccessColor}"/>
                                                    <TextBlock Text="{Binding UplinkSavedRatio}" FontWeight="SemiBold" FontSize="12" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SuccessColor}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="3,0,0,0">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding [traffic_batches], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource MutedForegroundColor}"/>
                                                    <TextBlock Text="{Binding UplinkBatches}" FontWeight="SemiBold" FontSize="12" FontFamily="{DynamicResource MonoFont}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Quantile Row: Batching -->
                                        <Grid ColumnDefinitions="50, *, *, *, *" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding [client_batching], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P50" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkBatchingP50}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P90" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkBatchingP90}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P99" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkBatchingP99}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="4" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="MAX" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkBatchingMax}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Quantile Row: Compression -->
                                        <Grid ColumnDefinitions="50, *, *, *, *" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding [client_compression], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P50" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkCompP50}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P90" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkCompP90}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P99" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkCompP99}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="4" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="MAX" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UplinkCompMax}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Downlink Direction Card -->
                                <Border Grid.Column="1" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4,0,0,0">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="↓" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryColor}"/>
                                                <TextBlock Text="{Binding [traffic_downlink], Source={x:Static i18n:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryColor}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding DownlinkRawWireText}" FontSize="11" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="*, *">
                                            <Border Grid.Column="0" Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,3,0">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding [client_saved], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource SuccessColor}"/>
                                                    <TextBlock Text="{Binding DownlinkSavedRatio}" FontWeight="SemiBold" FontSize="12" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SuccessColor}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="3,0,0,0">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding [traffic_batches], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource MutedForegroundColor}"/>
                                                    <TextBlock Text="{Binding DownlinkBatches}" FontWeight="SemiBold" FontSize="12" FontFamily="{DynamicResource MonoFont}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Quantile Row: Batching -->
                                        <Grid ColumnDefinitions="50, *, *, *, *" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding [client_batching], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P50" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkBatchingP50}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P90" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkBatchingP90}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P99" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkBatchingP99}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="4" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="MAX" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkBatchingMax}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Quantile Row: Compression -->
                                        <Grid ColumnDefinitions="50, *, *, *, *" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding [client_compression], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P50" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkCompP50}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P90" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkCompP90}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="P99" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkCompP99}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="4" Background="{DynamicResource CardColor}" CornerRadius="4" Padding="4,2" Margin="2,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="MAX" FontSize="8" Foreground="{DynamicResource MutedForegroundColor}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DownlinkCompMax}" FontSize="9" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Lifetime Mode Details (3 Cards) -->
                        <Grid IsVisible="{Binding IsLifetimeMode}" ColumnDefinitions="*, *, *">
                            <Border Grid.Column="0" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,4,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding [client_raw], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource MutedForegroundColor}"/>
                                    <TextBlock Text="{Binding LifetimeRawText}" FontWeight="SemiBold" FontSize="13" FontFamily="{DynamicResource MonoFont}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="4,0,4,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding [client_wire], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource MutedForegroundColor}"/>
                                    <TextBlock Text="{Binding LifetimeWireText}" FontWeight="SemiBold" FontSize="13" FontFamily="{DynamicResource MonoFont}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource GhostColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="4,0,0,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding [client_saved], Source={x:Static i18n:LocalizationManager.Instance}}" FontSize="9" Foreground="{DynamicResource SuccessColor}"/>
                                    <TextBlock Text="{Binding LifetimeSavedText}" FontWeight="SemiBold" FontSize="13" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SuccessColor}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </shadui:Card>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
