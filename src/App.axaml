<Application
    x:Class="Prism.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    Name="Prism"
    RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Prism/Views/Controls/EmptyState.axaml"/>
                <ResourceInclude Source="avares://Prism/Views/Controls/ErrorBanner.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- MutedForegroundColor is not a theme key. Alias the theme muted color so existing bindings follow light and dark. -->
            <SolidColorBrush x:Key="MutedForegroundColor" Color="{DynamicResource MutedColor}"/>
            <!-- Sparkline properties are IBrush. Theme status keys are Color, so these brushes track them without replacing the theme keys. -->
            <SolidColorBrush x:Key="StatusSuccessBrush" Color="{DynamicResource SuccessColor}"/>
            <SolidColorBrush x:Key="StatusSuccessFillBrush" Color="{DynamicResource SuccessColor10}"/>
            <SolidColorBrush x:Key="StatusWarningBrush" Color="{DynamicResource WarningColor}"/>
            <SolidColorBrush x:Key="StatusDestructiveBrush" Color="{DynamicResource DestructiveColor}"/>
            <FontFamily x:Key="MonoFont">Consolas, Menlo, "DejaVu Sans Mono", monospace</FontFamily>
            <Thickness x:Key="PageMargin">24,20</Thickness>
            <x:Double x:Key="PageMaxWidth">960</x:Double>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <shadui:ShadTheme />
        <!-- Library ToggleButton has no selected fill. Segment is the app's choice-group look. -->
        <Style Selector="ToggleButton.Segment">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource MdCornerRadius}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.Segment:checked">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundColor}"/>
        </Style>
        <Style Selector="ToggleButton.Segment:checked /template/ Border#NameBaseBackground">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
        </Style>
        <Style Selector="ToggleButton.Segment:checked /template/ Border#NameHoverBackground">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="ToggleButton.Segment:pointerover:not(:checked) /template/ Border#NameHoverBackground">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ListBox.LogList ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource GhostHoverColor}"/>
        </Style>
        <!-- Library ToggleSwitch has RenderTransform scaling that causes clipping at container edges. -->
        <Style Selector="ToggleSwitch">
            <Setter Property="RenderTransform" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </Application.Styles>
    <TrayIcon.Icons>
        <TrayIcons />
    </TrayIcon.Icons>
</Application>
